MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Nghiệm pháp dung nạp glucose đường uống"}) CREATE (a)-[r:DIAGNOSED_BY]->(b) SET r.evidence = "Định lượng sau khi đói từ 8-12 giờ (FPG) hoặc sau 2 giờ uống 75 g (người lớn) hoặc 1,75 g (trẻ em) dung dịch glucose đậm đặc (nghiệm pháp dung nạp glucose đường uống) là tốt nhất.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Định lượng glucose huyết tương ngẫu nhiên"}) CREATE (a)-[r:DIAGNOSED_BY]->(b) SET r.evidence = "Trong thực hành, đái tháo đường hoặc rối loạn glucose lúc đói thường được chẩn đoán bằng sử dụng định lượng glucose huyết tương ngẫu nhiên hoặc HbA1c.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Định lượng HbA1c"}) CREATE (a)-[r:DIAGNOSED_BY]->(b) SET r.evidence = "Định lượng HbA1c phản ánh nồng độ glucose trong 3 tháng trước. Định lượng HbA1c hiện được đưa vào tiêu chuẩn chẩn đoán đái tháo đường:", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Chế độ ăn uống"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Chế độ ăn – dinh dưỡng: Xây dựng chế độ dinh dưỡng phù hợp với mức độ thừa cân, nhu cầu, thói quen, phác đồ điều trị,… của từng bệnh nhân, thông thường gồm 45 - 65% carbohydrate, 25 - 35% chất béo (chất béo bão hoà < 7%) và 10 - 35% protein.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Tăng cường vận động"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Vận động thể lực: Giúp cải thiện tình trạng kháng insulin, kiểm soát đường huyết và giảm nguy cơ mắc các bệnh tim mạch, bằng cách giảm hoặc duy trì cân nặng, vận động 30 - 45 phút mỗi ngày x 3 - 5 ngày/tuần hoặc 150 phút/tuần với cường độ tập trung bình.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Sulfonylureas"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Các thuốc hạ đường huyết đường uống bao gồm: Sulfonylureas là thuốc kích thích tụy tiết insulin. Các thuốc này làm hạ glucose máu bằng cách kích thích tế bào beta của tụy tiết insulin và tăng nhạy cảm insulin với các mô ngoại vi và tại gan.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Repaglinide"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Các thuốc kích thích tiết insulin tác dụng ngắn như (repaglinide, nateglinide) kích thích tiết insulin tương tự như sulfonylureas.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Nateglinide"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Các thuốc kích thích tiết insulin tác dụng ngắn như (repaglinide, nateglinide) kích thích tiết insulin tương tự như sulfonylureas.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Metformin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Biguanides (metformin) làm giảm lượng glucose trong huyết tương bằng cách giảm sản xuất glucose ở gan (tạo gluconeogenesis và glycogenolysis).", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Troglitazone"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Thiazolidinediones (TZDs) (bao gồm troglitazone, rosiglitazone, pioglitazone) làm giảm đề kháng insulin ở mô ngoại vi (chất nhạy cảm với insulin), nhưng đi kèm với nhiều tác dụng phụ nguy hiểm.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Rosiglitazone"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Thiazolidinediones (TZDs) (bao gồm troglitazone, rosiglitazone, pioglitazone) làm giảm đề kháng insulin ở mô ngoại vi (chất nhạy cảm với insulin), nhưng đi kèm với nhiều tác dụng phụ nguy hiểm.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Alpha-glucosidase"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Ức chế alpha-glucosidase: Ức chế enzym ruột, do đó làm giảm glucose máu sau ăn. Chất ức chế apha-glucosidase kém hiệu quả hơn so với các thuốc uống khác trong việc giảm glucose máu, bệnh nhân thường ngừng thuốc do khó thở, thừa dịch và tiêu chảy.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Alogliptin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Chất ức chế dipeptidyl peptidase-4 (ví dụ, alogliptin, linagliptin , saxagliptin, sitagliptin).", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
