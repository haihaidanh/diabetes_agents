MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Insulin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Ngoài ra, bệnh nhân tiểu đường tuýp 2 cũng có thể dùng thuốc hạ đường huyết hoặc bổ sung thêm insulin nếu không đáp ứng với thuốc đường uống, có hiện tượng đường huyết tăng cao, men gan cao kèm theo biến chứng suy thận, ốm sốt,…", r.url = "https://nhathuoclongchau.com.vn/bai-viet/phan-biet-tieu-duong-tuyp-1-va-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Xây dựng chế độ ăn uống lành mạnh, đầy đủ dưỡng chất"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Đối với tiểu đường tuýp 2 thì bạn có thể phòng ngừa bằng các cách như sau: xây dựng chế độ ăn uống lành mạnh, đầy đủ dưỡng chất, kiêng đồ ăn nhiều chất béo và đường, bổ sung nhiều rau xanh vào thực đơn cho người tiểu đường tuýp 2 , chú ý tập thể dục và duy trì vận động điều độ mỗi ngày.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/phan-biet-tieu-duong-tuyp-1-va-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Kiêng đồ ăn nhiều chất béo và đường"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Đối với tiểu đường tuýp 2 thì bạn có thể phòng ngừa bằng các cách như sau: xây dựng chế độ ăn uống lành mạnh, đầy đủ dưỡng chất, kiêng đồ ăn nhiều chất béo và đường, bổ sung nhiều rau xanh vào thực đơn cho người tiểu đường tuýp 2 , chú ý tập thể dục và duy trì vận động điều độ mỗi ngày.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/phan-biet-tieu-duong-tuyp-1-va-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Chế độ sinh hoạt, tập luyện khoa học"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Kiên trì áp dụng các biện pháp này sẽ giúp đốt cháy lượng mỡ thừa trong cơ thể rất tốt, đồng thời hạn chế được tình trạng kháng insulin. Chế độ sinh hoạt, tập luyện khoa học giúp bạn kiểm soát bệnh hiệu quả", r.url = "https://nhathuoclongchau.com.vn/bai-viet/phan-biet-tieu-duong-tuyp-1-va-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Suy giảm chức năng của tế bào beta tuyến tụy"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "Người bệnh đái tháo đường tuýp 2 mặc dù cơ thể vẫn có khả năng sản xuất insulin, nhưng insulin không thể chuyển hóa (điều hòa) được lượng đường trong máu, do suy giảm chức năng của tế bào beta tuyến tụy tiến triển trên nền tảng đề kháng insulin.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Người trên 40 tuổi"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "Đa phần bệnh thường gặp ở những người trên 40 tuổi nhưng hiện nay đang có xu hướng dần trẻ hóa.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
