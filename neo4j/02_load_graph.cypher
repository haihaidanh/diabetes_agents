MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Thăm khám định kỳ"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Thăm khám định kỳ để được theo dõi tình trạng sức khỏe, diễn tiến của bệnh và để bác sĩ tìm hướng điều trị phù hợp trong thời gian tiếp theo nếu bệnh chưa có dấu hiệu thuyên giảm.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
