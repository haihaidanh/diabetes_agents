MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Đề kháng insulin tại cơ, gan, mô mỡ"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "tiểu đường tuýp 2 lại là tình trạng mạn tính phát triển từ từ theo thời gian. Do cơ thể người bệnh không sử dụng insulin đúng cách (đề kháng insulin tại cơ, gan, mô mỡ kèm suy giảm dần chức năng tế bào β theo thời gian), khiến cho lượng đường trong máu tăng cao.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/phan-biet-tieu-duong-tuyp-1-va-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Không tập thể dục thường xuyên"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "hoặc người bệnh thiếu hụt sản xuất insulin và cần thay thế insulin. Ngoài ra, một số yếu tố khác liên quan đến thói quen sống như không tập thể dục thường xuyên, thừa cân, béo phì (đặc biệt béo bụng), chế độ ăn không lành mạnh, tiền sử gia đình, tuổi cao, ngoài ra còn gặp ở người có tiền sử đái tháo đường thai kỳ, buồng trứng đa nang (PCOS), rối loạn giấc ngủ/ngưng thở khi ngủ, dùng glucocorticoid kéo dài, hút thuốc, uống rượu bia nhiều là nguy cơ khởi phát bệnh.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/phan-biet-tieu-duong-tuyp-1-va-tuyp-2.html";
