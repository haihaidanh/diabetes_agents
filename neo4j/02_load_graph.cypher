MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Saxagliptin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Chất ức chế dipeptidyl peptidase-4 (ví dụ, alogliptin, linagliptin , saxagliptin, sitagliptin).", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Sitagliptin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Chất ức chế dipeptidyl peptidase-4 (ví dụ, alogliptin, linagliptin , saxagliptin, sitagliptin).", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Canagliflozin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Thuốc ức chế SGLT2 như canagliflozin, dapagliflozin, empagliflozin ức chế SGLT2 ở phần gần ống thận, nó ức chế tái hấp thu glucose bởi vậy nó gây ra glucose niệu và làm giảm glucose máu.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Dapagliflozin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Thuốc ức chế SGLT2 như canagliflozin, dapagliflozin, empagliflozin ức chế SGLT2 ở phần gần ống thận, nó ức chế tái hấp thu glucose bởi vậy nó gây ra glucose niệu và làm giảm glucose máu.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Empagliflozin"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Thuốc ức chế SGLT2 như canagliflozin, dapagliflozin, empagliflozin ức chế SGLT2 ở phần gần ống thận, nó ức chế tái hấp thu glucose bởi vậy nó gây ra glucose niệu và làm giảm glucose máu.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "GLP-1"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Đồng vận thụ thể GLP-1:", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Liraglutide"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Đồng vận thụ thể GLP-1: Liraglutide, dulaglutide, albiglutide, làm tiết insulin phụ thuộc glucose và chậm làm trống dạ dày.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Dulaglutide"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Đồng vận thụ thể GLP-1: Liraglutide, dulaglutide, albiglutide, làm tiết insulin phụ thuộc glucose và chậm làm trống dạ dày.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Albiglutide"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Đồng vận thụ thể GLP-1: Liraglutide, dulaglutide, albiglutide, làm tiết insulin phụ thuộc glucose và chậm làm trống dạ dày.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Pramlintide"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Pramlintide tương tự amylin là một hormon do tế bào beta tụy tiết ra, giúp làm giảm nồng độ glucose sau ăn. Pramlintide làm chậm bài tiết glucagon sau ăn, làm chậm quá trình làm trống dạ dày, giúp no lâu. Được sử dụng đường tiêm, dạng kết hợp với insulin.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Lối sống tích cực"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Duy trì lối sống tích cực, hạn chế sự căng thẳng.", r.url = "https://nhathuoclongchau.com.vn/benh/benh-tieu-duong-289.html";
