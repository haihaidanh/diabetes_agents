MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Ăn rau xanh và hạt"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Rau xanh và các loại hạt là những thực phẩm chứa ít đường, ít tinh bột và nhiều chất xơ, vitamin, khoáng chất,... giúp ngừa bệnh tiểu đường.", r.url = "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Không hút thuốc"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Không hút thuốc", r.url = "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Bỏ thuốc lá"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Hút thuốc lá làm tăng nguy cơ mắc đái tháo đường trên 50% so với người không hút thuốc. Vì thế, nên bỏ hút thuốc hoặc không hút lá chủ động và thụ động giúp giảm đáng kể nguy cơ mắc đái tháo đường.", r.url = "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Uống rượu và bia có giới hạn"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Uống rượu hay bia trong giới hạn cho phép", r.url = "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Uống cồn vừa phải"}) CREATE (a)-[r:PREVENTED_BY]->(b) SET r.evidence = "Lượng cồn vừa phải ở nữ giới là khoảng 1 đơn vị mỗi ngày đối với nữ và tối đa 2 đơn vị mỗi ngày đối với nam. Trong đó một đơn vị cồn tương đương 1 lon bia 330ml.", r.url = "https://nhathuoclongchau.com.vn/benh/tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Dorocron"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Điều trị đái tháo đường typ 2 (không phụ thuộc insulin), phối hợp với chế độ ăn kiêng phù hợp, khi sự kiểm soát đường huyết không đạt được bằng chế độ ăn kiêng đơn thuần.", r.url = "https://nhathuoclongchau.com.vn/thuoc/dorocron-mr-60mg-domesco-2x15-28558.html";
MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Forxiga"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Forxiga được chỉ định để làm giảm nguy cơ nhập viện do suy tim ở bệnh nhân trưởng thành bị đái tháo đường týp 2 và hoặc có tiền sử bệnh lý tim mạch hoặc nhiều yếu tố nguy cơ tim mạch.", r.url = "https://nhathuoclongchau.com.vn/thuoc/forxiga-10mg-3713.html";
