MATCH (a:Entity {name: "Đái tháo đường tuýp 2"}), (b:Entity {name: "Hoa quả sấy khô"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "Người tiểu đường không nên ăn các loại hoa quả sấy khô. Bởi các loại hoa này đã bị loại bỏ hết nước, lượng đường trong quả sẽ cao gấp 3 lần so với hoa quả tươi. Vì vậy, người bệnh dễ bị tăng đường huyết đột biến khi ăn hoa quả sấy khô.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/nguoi-benh-tieu-duong-tuyp-2-nen-an-gi-va-kieng-gi.html";
