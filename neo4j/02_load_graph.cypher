MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Giảm cân nhanh chóng"}) CREATE (a)-[r:HAS_SYMPTOM]->(b) SET r.evidence = "Giảm cân nhanh chóng", r.url = "https://nhathuoclongchau.com.vn/bai-viet/7-dau-hieu-thuong-thay-o-nguoi-mac-benh-tieu-duong-6861.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Vết thương chậm lành"}) CREATE (a)-[r:HAS_SYMPTOM]->(b) SET r.evidence = "Vết thương chậm lành", r.url = "https://nhathuoclongchau.com.vn/bai-viet/7-dau-hieu-thuong-thay-o-nguoi-mac-benh-tieu-duong-6861.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Nhiễm trùng"}) CREATE (a)-[r:HAS_COMPLICATION]->(b) SET r.evidence = "Dễ mắc các bệnh nhiễm trùng", r.url = "https://nhathuoclongchau.com.vn/bai-viet/7-dau-hieu-thuong-thay-o-nguoi-mac-benh-tieu-duong-6861.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Biến chứng bàn chân đái tháo đường"}) CREATE (a)-[r:HAS_COMPLICATION]->(b) SET r.evidence = "Biến chứng bàn chân đái tháo đường là một vấn đề nghiêm trọng mà những người mắc bệnh đái tháo đường phải đối mặt.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/bien-chung-ban-chan-dai-thao-duong-nguyen-nhan-do-dau.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Bàn chân đái tháo đường"}) CREATE (a)-[r:HAS_COMPLICATION]->(b) SET r.evidence = "Bàn chân đái tháo đường là một biến chứng phức tạp của bệnh đái tháo đường, mang đến những vấn đề nghiêm trọng và ảnh hưởng đáng kể đến chất lượng cuộc sống, sinh hoạt và thậm chí tính mạng của những người bị mắc bệnh.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/bien-chung-ban-chan-dai-thao-duong-nguyen-nhan-do-dau.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Bàn chân tiểu đường"}) CREATE (a)-[r:HAS_COMPLICATION]->(b) SET r.evidence = "Bàn chân tiểu đường là một biến chứng phức tạp của bệnh đái tháo đường, vì vậy việc phòng ngừa rất quan trọng để tránh tình trạng này.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/bien-chung-ban-chan-dai-thao-duong-nguyen-nhan-do-dau.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Chỉ số đường huyết"}) CREATE (a)-[r:DIAGNOSED_BY]->(b) SET r.evidence = "Chỉ số đường huyết là giá trị thể hiện lượng glucose có trong máu, nguồn năng lượng chính cho các cơ quan, đặc biệt là não bộ và hệ thần kinh.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/chi-so-duong-huyet-binh-thuong-la-bao-nhieu-lam-sao-de-duy-tri-muc-duong-huyet-on-dinh.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Glucose"}) CREATE (a)-[r:HAS_SYMPTOM]->(b) SET r.evidence = "Một lượng lớn thức ăn được đưa vào cơ thể sẽ được chuyển hóa thành một loại đường gọi là glucose. Glucose sẽ được hấp thụ vào máu và đi vào các tế bào để trở thành năng lượng.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/co-che-benh-sinh-dai-thao-duong-la-gi-cac-nhom-thuoc-chua-benh-tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Tuyến tụy"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "Insulin là một loại hormone nội tiết do tuyến tụy sản xuất ra và có vai trò quan trọng trong việc điều hòa lượng glucose trong máu.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/co-che-benh-sinh-dai-thao-duong-la-gi-cac-nhom-thuoc-chua-benh-tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Năng lượng"}) CREATE (a)-[r:HAS_SYMPTOM]->(b) SET r.evidence = "Khi cơ chế hoạt động này diễn ra bình thường, cơ thể sẽ được cung cấp đầy đủ năng lượng cho các hoạt động sống.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/co-che-benh-sinh-dai-thao-duong-la-gi-cac-nhom-thuoc-chua-benh-tieu-duong-tuyp-2.html";
MATCH (a:Entity {name: "Đái tháo đường"}), (b:Entity {name: "Hệ thống"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "Tuy nhiên, khi hệ thống này hoạt động bất thường sẽ gây ra bệnh đái tháo đường hay còn gọi là tiểu đường.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/co-che-benh-sinh-dai-thao-duong-la-gi-cac-nhom-thuoc-chua-benh-tieu-duong-tuyp-2.html";
