MATCH (a:Entity {name: "Tiền tiểu đường"}), (b:Entity {name: "Đái tháo đường"}) CREATE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.evidence = "Một số mốc chỉ số HbA1c mà bạn cần biết là: Dưới 5.7%: Đường huyết ở mức bình thường. Từ 5.7% - 6,4%: Bạn đang ở giai đoạn tiền tiểu đường . Từ 6.5% trở lên: Bạn đã mắc phải căn bệnh đái tháo đường.", r.url = "https://nhathuoclongchau.com.vn/bai-viet/hba1c-la-gi-giai-ma-chi-so-hba1c-trong-phong-ngua-va-dieu-tri-tieu-duong-69472.html";
MATCH (a:Entity {name: "Tiền đái tháo đường"}), (b:Entity {name: "Chế độ ăn sạch"}) CREATE (a)-[r:TREATED_BY]->(b) SET r.evidence = "Hãy thực hiện một chế độ ăn “sạch”, hạn chế thức ăn chế biến sẵn, đồ ăn chiên xào, nhiều dầu mỡ. Khuyến khích ăn các thực phẩm giàu chất xơ, ăn các món luộc và sử dụng ít muối. Nên thay thế các thực phẩm chứa đường bột nguyên chất như gạo trắng, khoai tây,... sang các loại gạo lứt, ngũ cốc, các loại đậu,...", r.url = "https://nhathuoclongchau.com.vn/bai-viet/bi-tien-tieu-duong-co-chua-khoi-duoc-khong-59485.html";
