    {a: "diabetes", b: "type_of_insulin", fact_id: "0664d2807a29", section: "trang-36", evidence: "Disaggregation Type of diabetes, type of insulin, type of insulin delivery device, type of blood glucose self-monitoring."},
    {a: "diabetes", b: "type_of_blood_glucose_self_monitoring", fact_id: "1b3f4e28d063", section: "trang-36", evidence: "Disaggregation Type of diabetes, type of insulin, type of insulin delivery device, type of blood glucose self-monitoring."},
    {a: "diabetes_complications", b: "hypertension", fact_id: "b4a7dc7aa898", section: "trang-22", evidence: "Focusing on reducing the prevalence of modifiable risk factors for diabetes and diabetes complications, this domain includes monitoring of physical inactivity, obesity and overweight, tobacco use and hypertension in the general population as well as glycaemic control and having good control of blood pressure and lipid levels among people with diabetes."},
    {a: "diabetes_complications", b: "glycaemic_control", fact_id: "10f3cdcbe2d8", section: "trang-22", evidence: "Focusing on reducing the prevalence of modifiable risk factors for diabetes and diabetes complications, this domain includes monitoring of physical inactivity, obesity and overweight, tobacco use and hypertension in the general population as well as glycaemic control and having good control of blood pressure and lipid levels among people with diabetes."},
    {a: "diabetes_complications", b: "glycaemic_control_based_on_glycated_haemoglobin_hba1c", fact_id: "4edd718f59c0", section: "trang-19", evidence: "Risk factors for diabetes complications \n◆ Glycaemic control based on glycated haemoglobin (HbA1c) \n◆ Glycaemic control based on fasting plasma glucose \n◆ Blood pressure control"},
    {a: "diabetes_complications", b: "glycaemic_control_based_on_fasting_plasma_glucose", fact_id: "754eed9f4433", section: "trang-19", evidence: "Risk factors for diabetes complications \n◆ Glycaemic control based on glycated haemoglobin (HbA1c) \n◆ Glycaemic control based on fasting plasma glucose \n◆ Blood pressure control"},
    {a: "diabetes_complications", b: "lipid_levels", fact_id: "18763b8e44f6", section: "trang-22", evidence: "Focusing on reducing the prevalence of modifiable risk factors for diabetes and diabetes complications, this domain includes monitoring of physical inactivity, obesity and overweight, tobacco use and hypertension in the general population as well as glycaemic control and having good control of blood pressure and lipid levels among people with diabetes."},
    {a: "diabetes_complications", b: "blood_pressure_control", fact_id: "8f528e631912", section: "trang-19", evidence: "Risk factors for diabetes complications \n◆ Glycaemic control based on glycated haemoglobin (HbA1c) \n◆ Glycaemic control based on fasting plasma glucose \n◆ Blood pressure control"},
    {a: "glycaemic_control", b: "global_target", fact_id: "39618a37096d", section: "trang-66", evidence: "Global target: <8% (64mmol/mol)"},
    {a: "glycaemic_control", b: "clinical_target", fact_id: "78523c46aef6", section: "trang-66", evidence: "Clinical target: <7% (53mmol/mol)"},
    {a: "cardiovascular_disease", b: "diabetes", fact_id: "f3921ce2850e", section: "trang-73", evidence: "Denominator Total number of people with diabetes registered in the facility."},
    {a: "probability_of_death_between_exact_age_30_and_exact_age_70", b: "diabetes", fact_id: "999f78d989af", section: "trang-80", evidence: "Limitations/comments The ICD codes to be included in the calculation are: cardiovascular disease: I00-I99, Cancer: C00-C97, Diabetes: E10-E14, Chronic respiratory: J30-J98."},
    {a: "probability_of_death_between_exact_age_30_and_exact_age_70", b: "cardiovascular_disease", fact_id: "80c9253b0b71", section: "trang-80", evidence: "Limitations/comments The ICD codes to be included in the calculation are: cardiovascular disease: I00-I99, Cancer: C00-C97, Diabetes: E10-E14, Chronic respiratory: J30-J98."},
    {a: "probability_of_death_between_exact_age_30_and_exact_age_70", b: "cancer", fact_id: "886da8cd2983", section: "trang-80", evidence: "Limitations/comments The ICD codes to be included in the calculation are: cardiovascular disease: I00-I99, Cancer: C00-C97, Diabetes: E10-E14, Chronic respiratory: J30-J98."},
    {a: "probability_of_death_between_exact_age_30_and_exact_age_70", b: "chronic_respiratory", fact_id: "7dcb0df83944", section: "trang-80", evidence: "Limitations/comments The ICD codes to be included in the calculation are: cardiovascular disease: I00-I99, Cancer: C00-C97, Diabetes: E10-E14, Chronic respiratory: J30-J98."}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:HAS_RISK_FACTOR {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_6
}
RETURN source.id AS source_id, concept_count,
       rel_count_1 + rel_count_2 + rel_count_3 + rel_count_4 + rel_count_5 + rel_count_6 AS fact_count;
