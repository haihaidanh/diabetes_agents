  WITH source
  UNWIND [
    {a: "diabetes", b: "cardiovascular_diseases", fact_id: "bc256188dd1c", section: "trang-13", evidence: "By contrast, the risk of dying from any one of the four main noncommunicable diseases (NCDs) (i.e. cardiovascular diseases, cancers, chronic respiratory diseases or diabetes) between the ages of 30 and 70 decreased by 20% globally in the same period (3)."},
