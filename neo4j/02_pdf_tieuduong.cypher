    {a: "diabetic_foot", b: "diabetes", fact_id: "a78242748022", section: "trang-22", evidence: "This domain highlights the execution of health care services for prevention, detection and management of diabetes, including detection and prevention strategies for diabetes and its risk factors, such as hypertension and cardiovascular disease risk assessment, complication assessment, preventive measures and monitoring for diabetes-related complications (e.g. retinopathy, chronic kidney disease, and diabetic foot), and processes of care."},
    {a: "cardiovascular_disease_among_people_with_diabetes", b: "stroke", fact_id: "52943b499bc3", section: "trang-74", evidence: "Cardiovascular disease among people with diabetes, includes: ● myocardial infarction; ● stroke; and ● lower-extremity vascular occlusion."},
    {a: "cardiovascular_disease_among_people_with_diabetes", b: "myocardial_infarction", fact_id: "8ac20f4e25d1", section: "trang-74", evidence: "Cardiovascular disease among people with diabetes, includes: ● myocardial infarction; ● stroke; and ● lower-extremity vascular occlusion."},
    {a: "cardiovascular_disease_among_people_with_diabetes", b: "lower_extremity_vascular_occlusion", fact_id: "33aac9c2c75b", section: "trang-74", evidence: "Cardiovascular disease among people with diabetes, includes: ● myocardial infarction; ● stroke; and ● lower-extremity vascular occlusion."},
    {a: "probability_of_premature_mortality_from_noncommunicable_diseases", b: "diabetes", fact_id: "7c22d025e76c", section: "trang-80", evidence: "Definition Probability of dying between the exact ages 30 and 70 years from cardiovascular diseases, cancer, diabetes, or chronic respiratory diseases."},
    {a: "probability_of_premature_mortality_from_noncommunicable_diseases", b: "cardiovascular_diseases", fact_id: "3c7831f92068", section: "trang-80", evidence: "Definition Probability of dying between the exact ages 30 and 70 years from cardiovascular diseases, cancer, diabetes, or chronic respiratory diseases."},
    {a: "probability_of_premature_mortality_from_noncommunicable_diseases", b: "chronic_respiratory_diseases", fact_id: "c724582d30c8", section: "trang-80", evidence: "Definition Probability of dying between the exact ages 30 and 70 years from cardiovascular diseases, cancer, diabetes, or chronic respiratory diseases."},
    {a: "probability_of_premature_mortality_from_noncommunicable_diseases", b: "cancer", fact_id: "ee2ff8dfd0b3", section: "trang-80", evidence: "Definition Probability of dying between the exact ages 30 and 70 years from cardiovascular diseases, cancer, diabetes, or chronic respiratory diseases."}
  ] AS row
