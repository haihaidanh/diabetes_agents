CALL {
  WITH source
  UNWIND [
    {a: "diabetes", b: "targeted_interventions", fact_id: "899a7e2e4ff6", section: "trang-13", evidence: "By doing so, it facilitates the identification of variations in diabetes prevention and treatment practices, and disparities in access to care, thus informing targeted interventions and policy initiatives."},
    {a: "diabetes", b: "data_driven_decision_making", fact_id: "e3367ec55ec1", section: "trang-13", evidence: "This involves strengthening health information systems to ensure routine collection and reporting of diabetes indicators and promoting data-driven decision-making at all health system levels."},
    {a: "diabetes", b: "governance", fact_id: "245e5f66d7aa", section: "trang-22", evidence: "This domain underscores the essential components needed for effective diabetes prevention and control. It includes governance, finance, health workforce, medicine and technology availability, and establishment of health information systems, with a focus on the level of health care facilities."},
    {a: "diabetes", b: "finance", fact_id: "b424848263e0", section: "trang-22", evidence: "This domain underscores the essential components needed for effective diabetes prevention and control. It includes governance, finance, health workforce, medicine and technology availability, and establishment of health information systems, with a focus on the level of health care facilities."},
    {a: "diabetes", b: "health_workforce", fact_id: "525017ae3d54", section: "trang-22", evidence: "This domain underscores the essential components needed for effective diabetes prevention and control. It includes governance, finance, health workforce, medicine and technology availability, and establishment of health information systems, with a focus on the level of health care facilities."},
    {a: "diabetes", b: "medicine_and_technology_availability", fact_id: "d093b400a4ec", section: "trang-22", evidence: "This domain underscores the essential components needed for effective diabetes prevention and control. It includes governance, finance, health workforce, medicine and technology availability, and establishment of health information systems, with a focus on the level of health care facilities."},
    {a: "diabetes", b: "establishment_of_health_information_systems", fact_id: "13e9ebb04be4", section: "trang-22", evidence: "This domain underscores the essential components needed for effective diabetes prevention and control. It includes governance, finance, health workforce, medicine and technology availability, and establishment of health information systems, with a focus on the level of health care facilities."},
    {a: "diabetes", b: "policies_and_legislation_for_diabetes_prevention", fact_id: "fcdbe6f08fb4", section: "trang-22", evidence: "m Existence and implementation of policies and legislation for diabetes prevention"},
    {a: "diabetes", b: "data_analysis_and_interpretation", fact_id: "d29cdea8dd25", section: "trang-25", evidence: "Strengthening capacities for data analysis, interpretation, and dissemination Building local capacities in data analysis and interpretation is essential for turning data into actionable insights."},
    {a: "diabetes", b: "informed_decision_making", fact_id: "1be83a383518", section: "trang-25", evidence: "Creating effective channels for data dissemination ensures that insights reach all relevant stakeholders, facilitating informed decision-making at all levels of the health system."},
    {a: "diabetes", b: "stratify", fact_id: "8c5e08190e2d", section: "trang-73", evidence: "Method of estimation Numerator ÷ denominator × 100 Disaggregation Where possible and applicable, stratify by cause of admission, facility level of care type, provider ownership type (public/private), and individual-level characteristics such as age, sex, race/ethnicity, comorbidity status, highrisk groups, socioeconomic status, residence type (urban/rural), and health insurance type."},
    {a: "diabetes", b: "age_standardized", fact_id: "303762a13fc1", section: "trang-73", evidence: "Limitations/comments For comparison with other health care facilities the indicator needs to be age-standardized."},
    {a: "diabetes", b: "national_diabetes_prevention_and_control_plan", fact_id: "02766277c185", section: "trang-22", evidence: "m Existence and implementation of national diabetes prevention and control plan"},
    {a: "overweight", b: "stratify_individuals_with_or_without_diabetes", fact_id: "71cbfb419e6d", section: "trang-63", evidence: "Method of estimation Numerator ÷ denominator × 100 Disaggregation Where possible and applicable, stratify individuals with or without diabetes, by obesity or overweight, individual characteristics such as age, sex, race/ ethnicity, comorbidity status, high-risk groups, socioeconomic status, residence type (urban/rural), and health insurance type."}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:PREVENTED_BY {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_5
}
