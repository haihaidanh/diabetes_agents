CALL {
  WITH source
  UNWIND [
    {a: "insulin", b: "national_health_benefit_package", fact_id: "caa4ddf5f0aa", section: "trang-35", evidence: "Inclusion of insulin and insulin delivery devices in the national health benefit package is validated by examining the national health benefit package document for insulin, insulin delivery devices and blood glucose self-monitoring coverage."},
    {a: "diabetes", b: "global_diabetes_compact", fact_id: "82d98945bcc1", section: "trang-13", evidence: "In response to the increasing burden of diabetes, the World Health Organization (WHO) launched the Global Diabetes Compact in 2021 (5)."},
    {a: "diabetes", b: "who_global_action_plan_for_the_prevention_and_control_of_non_93e3bc", fact_id: "85c8c32fb046", section: "trang-13", evidence: "The diabetes programme spearheaded by the Global Diabetes Compact is aligned with the overarching objectives of WHO Global action plan for the prevention and control of noncommunicable diseases (12), which are aimed at enhancing the prevention, management and monitoring of NCDs, including diabetes."},
    {a: "diabetes", b: "who_package_of_essential_noncommunicable_pen_disease_interve_6d282e", fact_id: "da03faf39f8e", section: "trang-13", evidence: "This is addressed by the WHO Package of essential noncommunicable (PEN) disease interventions for primary health care (13), the WHO HEARTS-D module on the diagnosis and management of type 2 diabetes (14), the WHO Noncommunicable diseases global monitoring framework (15), the WHO Noncommunicable disease facility-based monitoring guidance (16), the WHO STEPwise approach to noncommunicable disease riskfactor surveillance (17), and other guidance."},
    {a: "diabetes", b: "who_hearts_d_module_on_the_diagnosis_and_management_of_type_2_diabetes", fact_id: "db4a48ef8fb0", section: "trang-13", evidence: "This is addressed by the WHO Package of essential noncommunicable (PEN) disease interventions for primary health care (13), the WHO HEARTS-D module on the diagnosis and management of type 2 diabetes (14), the WHO Noncommunicable diseases global monitoring framework (15), the WHO Noncommunicable disease facility-based monitoring guidance (16), the WHO STEPwise approach to noncommunicable disease riskfactor surveillance (17), and other guidance."},
    {a: "diabetes", b: "who_noncommunicable_diseases_global_monitoring_framework", fact_id: "faa553767772", section: "trang-13", evidence: "This is addressed by the WHO Package of essential noncommunicable (PEN) disease interventions for primary health care (13), the WHO HEARTS-D module on the diagnosis and management of type 2 diabetes (14), the WHO Noncommunicable diseases global monitoring framework (15), the WHO Noncommunicable disease facility-based monitoring guidance (16), the WHO STEPwise approach to noncommunicable disease riskfactor surveillance (17), and other guidance."},
    {a: "diabetes", b: "noncommunicable_disease_facility_based_monitoring_guidance", fact_id: "9c5597a290f7", section: "trang-13", evidence: "This is addressed by the WHO Package of essential noncommunicable (PEN) disease interventions for primary health care (13), the WHO HEARTS-D module on the diagnosis and management of type 2 diabetes (14), the WHO Noncommunicable diseases global monitoring framework (15), the WHO Noncommunicable disease facility-based monitoring guidance (16), the WHO STEPwise approach to noncommunicable disease riskfactor surveillance (17), and other guidance."},
    {a: "diabetes", b: "who_stepwise_approach_to_noncommunicable_disease_riskfactor_567e80", fact_id: "c412e8628f20", section: "trang-13", evidence: "This is addressed by the WHO Package of essential noncommunicable (PEN) disease interventions for primary health care (13), the WHO HEARTS-D module on the diagnosis and management of type 2 diabetes (14), the WHO Noncommunicable diseases global monitoring framework (15), the WHO Noncommunicable disease facility-based monitoring guidance (16), the WHO STEPwise approach to noncommunicable disease riskfactor surveillance (17), and other guidance."},
    {a: "diabetes", b: "standardized_indicators", fact_id: "14d1a5d061d8", section: "trang-13", evidence: "The objectives of the guidance are multifaceted. Firstly, it aims to establish standardized indicators that enable consistent monitoring and comparison of diabetes responses and outcomes across countries and regions."},
    {a: "diabetes", b: "global_targets", fact_id: "2ba77f72cabf", section: "trang-13", evidence: "Thirdly, the guidance aims to support countries in achieving global targets including the coverage targets for diabetes care and management, as well as related risk factors outlined in the global NCD targets and NCD premature mortality target indicated in the Sustainable Development Goals."},
    {a: "diabetes", b: "monitoring_framework", fact_id: "e10d2ae7165b", section: "trang-13", evidence: "The introduction of the monitoring framework for diabetes prevention and control marks a pivotal step towards realizing these objectives on a global scale."},
    {a: "diabetes", b: "better_health_outcomes", fact_id: "dd98b94ddc37", section: "trang-13", evidence: "By offering a structured methodology for data collection, analysis and utilization, the framework seeks to empower policymakers, health care providers and other stakeholders to strengthen diabetes prevention and control, thereby achieving better health outcomes worldwide."},
    {a: "diabetes", b: "universal_health_coverage", fact_id: "96490461188d", section: "trang-13", evidence: "Furthermore, it emphasizes the critical role of diabetes monitoring and surveillance in advancing towards universal health coverage and ensuring that no individual is left behind."},
    {a: "diabetes", b: "systematic_review", fact_id: "2d8b8631a1bc", section: "trang-13", evidence: "A systematic review of reviews was conducted to identify existing indicators designed for surveillance, monitoring and evaluation in the diabetes context."},
    {a: "diabetes", b: "peer_reviewed_published_literature", fact_id: "65037f86c027", section: "trang-13", evidence: "A search of peer-reviewed published literature as of 15 September 2023 in various databases such as PubMed (18), Embase (19), Cochrane Reviews (20), Cumulative Index to Nursing and Allied Health Literature (21) and Latin American and Caribbean Literature on Health Sciences (22) was implemented using search terms related to diabetes, monitoring, surveillance, evaluation metrics and indicators, filtered by ‘review’ (Annex A)."},
    {a: "diabetes", b: "full_text_articles", fact_id: "caf5e49fd4be", section: "trang-13", evidence: "This produced over 4500 unique titles/abstracts for screening, from which over 200 full text articles were selected for further review."},
    {a: "diabetes", b: "diabetes_indicators", fact_id: "eab68c4f3c49", section: "trang-13", evidence: "Ultimately, 58 studies collectively identified approximately 300 distinct diabetes indicators."},
    {a: "diabetes", b: "availability_of_diabetes_cardiovascular_disease_and_hyperten_777512", fact_id: "6c416e39d878", section: "trang-19", evidence: "Medicines and health technologies \n❖◆ Availability of diabetes, cardiovascular disease and hypertension core medicines \n❖◆ Availability of glycated haemoglobin (HbA1c) testing \nHealth workforce \n❖◆ Availability of trained health care staﬀ for diabetes management"},
    {a: "diabetes", b: "availability_of_glycated_haemoglobin_hba1c_testing", fact_id: "9bf3a5de1913", section: "trang-19", evidence: "Medicines and health technologies \n❖◆ Availability of diabetes, cardiovascular disease and hypertension core medicines \n❖◆ Availability of glycated haemoglobin (HbA1c) testing \nHealth workforce \n❖◆ Availability of trained health care staﬀ for diabetes management"},
    {a: "diabetes", b: "indicator_for_monitoring_global_ncd_target", fact_id: "2b79dc314bde", section: "trang-19", evidence: "Data sources: \n NCD country capacity survey, \n Population-based survey country reports, other surveys \n✦ Civil registration and vital \n❖ Health facility survey statistics system \n◆ Routine facility reporting system \n�� Indicator for monitoring global NCD target \n Indicator for monitoring global diabetes coverage target"},
    {a: "diabetes", b: "indicator_for_monitoring_global_diabetes_coverage_target", fact_id: "7e39a26ab179", section: "trang-19", evidence: "Data sources: \n NCD country capacity survey, \n Population-based survey country reports, other surveys \n✦ Civil registration and vital \n❖ Health facility survey statistics system \n◆ Routine facility reporting system \n�� Indicator for monitoring global NCD target \n Indicator for monitoring global diabetes coverage target"},
    {a: "diabetes", b: "diagnosed", fact_id: "2dbd1c3f0971", section: "trang-21", evidence: "● 80% of people with diabetes are diagnosed."},
    {a: "diabetes", b: "national_guidelines_for_diabetes_management", fact_id: "f7fd56fb7994", section: "trang-22", evidence: "m Existence of national guidelines for diabetes management"},
    {a: "diabetes", b: "glycated_haemoglobin_hba1c_testing", fact_id: "7161ce6e7bd1", section: "trang-22", evidence: "vu Availability of glycated haemoglobin (HbA1c) testing"},
    {a: "diabetes", b: "glycated_haemoglobin_hba1c", fact_id: "4be080000d20", section: "trang-22", evidence: "lu Glycaemic control based on glycated haemoglobin (HbA1c)"},
    {a: "diabetes", b: "fasting_plasma_glucose", fact_id: "2b8ffc13f879", section: "trang-22", evidence: "lu Glycaemic control based on fasting plasma glucose"},
    {a: "diabetes", b: "ncd_country_capacity_survey", fact_id: "43d24d989fc6", section: "trang-24", evidence: "Data collection frequency of key data sources Key data source Data collection frequency NCD country capacity survey and other surveys Every 2 years Health facility survey Every 3 to 5 years Routine facility reporting system Continuous Population-based survey Every 3 to 5 years CRVS Continuous NCD country capacity survey The NCD country capacity survey (26) is a global survey on national capacity for NCD prevention and control that is conducted regularly by WHO. This enables Member States and the global community to monitor progress and achievements in improving their capacities in responding to the epidemic of NCDs including diabetes. NCD country focal points respond to a standard online questionnaire depicting various aspects on health system infrastructure, financing, governance, surveillance, primary health care, partnerships and collaborations, specific to NCDs. It has been conducted in 2001, 2005, 2010 and biennially since 2013 and with 193 countries participating in the most recently conducted survey in 2023 (31)."},
    {a: "diabetes", b: "routine_facility_reporting_system", fact_id: "5ee21704023c", section: "trang-24", evidence: "The global framework for diabetes prevention and control Routine facility reporting system A key source of health services data is the routine facility reporting system that regularly collects data on health care resources, health service use, health outcomes and patterns that can generate aggregated statistics at different levels of the health system (33)."},
    {a: "diabetes", b: "who_mortality_database", fact_id: "103fad4bb38a", section: "trang-25", evidence: "The WHO mortality database contains data on registered deaths including cause of death, disaggregated by age, sex and ICD code submitted by over 120 countries (37)."},
    {a: "diabetes", b: "mortality_data", fact_id: "5746fafb1b83", section: "trang-25", evidence: "The quality of mortality data varies by country and year, with some country-reported deaths unregistered, and/or with incomplete or incorrect cause-of-death information, making the data unreliable."},
    {a: "diabetes", b: "plasma_glucose_testing", fact_id: "d5554c4bfe12", section: "trang-40", evidence: "Indicator name Availability of plasma glucose testing Purpose To assess the availability of testing services for diabetes diagnosis and management."},
    {a: "diabetes", b: "electronic_standardized_system", fact_id: "c39ad7d38189", section: "trang-42", evidence: "● “Does your country have an electronic standardized system for recording person-and facility-level data that includes diabetes in public facilities?”(The country is considered to have an electronic standardized system if it has an electronic type of system that covers more than 50% of facilities)."},
    {a: "diabetes", b: "type_1_diabetes_registry", fact_id: "e3a66e522873", section: "trang-42", evidence: "● “Does your country have a type 1 diabetes registry?”, indicate coverage (national, sub-national or others) and type (population- or hospital-based)."},
    {a: "diabetes", b: "regular_standardized_health_facility_surveys", fact_id: "17bb0e6f7f5f", section: "trang-42", evidence: "● “Does your country conduct standardized surveys of facilities to assess availability of health facility services including diabetes management services and on capacities of health facilities to provide these services at required standards of quality?” – indicate the year of last facility survey (The country has available regular standardized health facility surveys, if there are published survey statistics on availability, readiness, quality, management, and financing of diabetes management services, every 1 to 3 years)."},
    {a: "diabetes", b: "tobacco_use_assessment", fact_id: "33d6c0482b2b", section: "trang-46", evidence: "Purpose To assess the level of tobacco use assessment Definition Proportion of people with diabetes who were attending health facilities and were assessed for tobacco use by a health professional in the facility during the reporting period."},
    {a: "diabetes", b: "glycated_haemoglobin_hba1c_or_fasting_plasma_glucose_fpg_measurement", fact_id: "6541be9d1634", section: "trang-51", evidence: "Definition Proportion of people with diabetes registered in health facilities who were tested for glycaemic control using glycated haemoglobin (HbA1c) or fasting plasma glucose (FPG) measurement."},
    {a: "diabetes", b: "diabetic_foot_assessment", fact_id: "91da7d545e72", section: "trang-54", evidence: "Indicator name Assessment for diabetic foot among people with diabetes Purpose To assess the level of diabetic foot assessment among people with diabetes in health facilities."},
    {a: "diabetes", b: "hearts_d", fact_id: "9264d14da96a", section: "trang-73", evidence: "Related links HEARTS-D: diagnosis and management of type 2 diabetes. Geneva: World Health Organization; 2020 (https://iris.who.int/handle/10665/331710)."},
    {a: "diabetes", b: "health_facility_patient_registers", fact_id: "afc4dafd5920", section: "trang-73", evidence: "Sources of data Health facility patient registers, health records"},
    {a: "diabetes", b: "health_records", fact_id: "765ee0a62321", section: "trang-73", evidence: "Sources of data Health facility patient registers, health records"},
    {a: "diabetes", b: "icd_11_for_mortality_and_morbidity_statistics_acute_complica_6a4536", fact_id: "ec01f6343a7c", section: "trang-73", evidence: "ICD-11 for mortality and morbidity statistics: Acute complications of diabetes mellitus [website]. Geneva: World Health Organization; 2024 (https://icd.who.int/browse/2024-01/mms/en#1304552818, accessed 26 May 2024)."},
    {a: "diabetes", b: "icd_11_for_mortality_and_morbidity_statistics_diabetic_retinopathy", fact_id: "1b64cf86e43c", section: "trang-73", evidence: "ICD-11 for mortality and morbidity statistics: Diabetic retinopathy [website]. Geneva: World Health Organization; 2024 (https://icd.who.int/browse/2024-01/mms/en#1006882070, accessed 26 May 2024)."},
    {a: "diabetes", b: "icd_11_for_mortality_and_morbidity_statistics_chronic_kidney_disease", fact_id: "6f4ce6a2fd6d", section: "trang-73", evidence: "ICD-11 for mortality and morbidity statistics: Chronic kidney disease [website]. Geneva: World Health Organization; 2024 (https://icd.who.int/browse/2024-01/mms/en#412389819, accessed 26 May 2024)."},
    {a: "diabetes", b: "global_burden_of_disease_study_2021", fact_id: "b8487e46988e", section: "trang-81", evidence: "of diabetes from 1990 to 2021, with projections of prevalence to 2050: a systematic analysis for the Global Burden of Disease Study 2021. Lancet. 2023;402(10397):203–234. doi: 10.1016/ S0140-6736(23)01301-6."},
    {a: "diabetes", b: "evaluation_indicator", fact_id: "645b5b34327c", section: "trang-85", evidence: "( (“Diabetes”) AND ( “Evaluation Indicator*”[Title/Abstract] OR “Evaluation Benchmark*”[Title/Abstract] OR “Evaluation Metric*”[Title/Abstract] OR “Evaluation Index”[Title/Abstract] OR “Evaluation Indices”[Title/Abstract] OR “Process Indicator*”[Title/Abstract] OR “Process Benchmark*”[Title/Abstract] OR “Process Metric*”[Title/Abstract] OR “Process Index”[Title/Abstract] OR “Process Indices”[Title/Abstract] OR “Outcome Indicator*”[Title/Abstract] OR “Outcome Benchmark*”[Title/Abstract] OR “Outcome Metric*”[Title/Abstract] OR “Outcome Index”[Title/ Abstract] OR “Outcome Indices”[Title/Abstract] OR “Performance Indicator*”[Title/Abstract] OR “Performance Benchmark*”[Title/Abstract] OR “Performance Metric*”[Title/Abstract] OR “Performance Index”[Title/Abstract] OR “Performance Indices”[Title/Abstract] OR “Surveillance Indicator*”[Title/Abstract] OR “Surveillance Benchmark*”[Title/Abstract] OR “Surveillance Metric*”[Title/Abstract] OR “Surveillance Index”[Title/Abstract] OR “Surveillance Indices”[Title/ Abstract] OR “Monitoring Indicator*”[Title/Abstract] OR “Monitoring Benchmark*”[Title/Abstract] OR “Monitoring Metric*”[Title/Abstract] OR “Monitoring Index”[Title/Abstract] OR “Monitoring Indices”[Title/Abstract] OR “Quality Indicator*”[Title/Abstract] OR “Quality Benchmark*”[Title/ Abstract] OR “Quality Metric*”[Title/Abstract] OR “Quality Index”[Title/Abstract] OR “Quality Indices”[Title/Abstract] OR “Capacity Indicator*”[Title/Abstract] OR “Capacity Benchmark*”[Title/ Abstract] OR “Capacity Metric*”[Title/Abstract] OR “Capacity Index”[Title/Abstract] OR “Capacity Indices”[Title/Abstract] OR “Governance Indicator*”[Title/Abstract] OR “Governance Benchmark*”[Title/Abstract] OR “Governance Metric*”[Title/Abstract] OR “Governance Index”[Title/ Abstract] OR “Governance Indices”[Title/Abstract] OR “Availability Indicator*”[Title/Abstract] OR “Availability Benchmark*”[Tit