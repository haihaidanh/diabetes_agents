    {id: "cang_thang_tam_ly_xa_hoi", name: "Căng thẳng tâm lý xã hội", category: "risk_factor"},
    {id: "che_do_an_uong_toan_dien", name: "Chế độ ăn uống toàn diện", category: "lifestyle"},
    {id: "benh_tieu_duong_loai_2", name: "Bệnh tiểu đường loại 2", category: "disease"},
    {id: "do_nong_do_glucose_huyet_tuong", name: "Đo nồng độ glucose huyết tương", category: "test"},
    {id: "sulfonylureas", name: "Sulfonylureas", category: "drug"}
  ] AS row
  MERGE (n:DiabetesConcept {id: row.id})
  SET n += row
  MERGE (source)-[:MENTIONS]->(n)
  RETURN count(*) AS concept_count
}
CALL {
  WITH source
  UNWIND [
    {a: "dai_thao_duong", b: "ha_duong_huyet", fact_id: "5b13066a21ab", evidence: "Bệnh nhân đã có tiền sử triệu chứng hạ đường huyết khi tập luyện nên được khuyên kiểm tra glucose máu và ăn carbonhydrate hoặc liều insulin thập hơn là cần thiết để có được glucose máu cao hơn bình thường trước khi tập luyện."},
    {a: "dai_thao_duong", b: "met", fact_id: "442ff1f3738a", evidence: "Mất nước nặng gây yếu, mệt, và thay đổi trạng thái tâm thần."},
    {a: "dai_thao_duong", b: "an_nhieu", fact_id: "b9284afd3fbf", evidence: "Ăn nhiều có thể liên quan đến triệu chứng của tăng đường huyết nhưng không phải triệu điển hình để bệnh nhân quan tâm."},
    {a: "dai_thao_duong", b: "uong_nhieu", fact_id: "138bd5a8a533", evidence: "Triệu chứng sớm liên quan tới tăng glucose máu và bao gồm uống nhiều, khát nhiều, tiểu nhiều và nhìn mờ."},
    {a: "dai_thao_duong", b: "nhin_mo", fact_id: "1dfe2dd8bb81", evidence: "Triệu chứng sớm liên quan tới tăng glucose máu và bao gồm uống nhiều, khát nhiều, tiểu nhiều và nhìn mờ."},
    {a: "dai_thao_duong", b: "tang_duong_huyet", fact_id: "cb62e140330b", evidence: "Đái tháo đường là suy giảm bài tiết insulin và nồng độ kháng insulin ngoại vi thay đổi dẫn đến tăng đường huyết."},
    {a: "dai_thao_duong", b: "khat_nhieu", fact_id: "6c4722b26c31", evidence: "Triệu chứng sớm liên quan tới tăng glucose máu và bao gồm uống nhiều, khát nhiều, tiểu nhiều và nhìn mờ."},
    {a: "dai_thao_duong", b: "yeu", fact_id: "e4a4cfdd2bda", evidence: "Mất nước nặng gây yếu, mệt, và thay đổi trạng thái tâm thần."},
    {a: "dai_thao_duong", b: "thay_doi_trang_thai_tam_than", fact_id: "51684c2f9270", evidence: "Mất nước nặng gây yếu, mệt, và thay đổi trạng thái tâm thần."},
    {a: "dai_thao_duong", b: "xu_huong_nhiem_khuan_hoac_nam", fact_id: "d0be4a613f56", evidence: "Tăng đường huyết cũng gây giảm cân, buồn nôn và nôn, và nhìn mờ, và xu hướng nhiễm khuẩn hoặc nấm."},
    {a: "dai_thao_duong", b: "duong_huyet_mao_mach", fact_id: "9a0607fb774d", evidence: "Máy đo đường huyết đầu ngón tay đo đường huyết mao mạch."},
    {a: "dai_thao_duong", b: "giam_can", fact_id: "e7bf766cc2a7", evidence: "Tăng đường huyết cũng gây giảm cân, buồn nôn và nôn, và nhìn mờ, và xu hướng nhiễm khuẩn hoặc nấm."},
    {a: "dai_thao_duong", b: "buon_non", fact_id: "3b676e8ac57b", evidence: "Tăng đường huyết cũng gây giảm cân, buồn nôn và nôn, và nhìn mờ, và xu hướng nhiễm khuẩn hoặc nấm."},
    {a: "dai_thao_duong", b: "non", fact_id: "aa6a7e9f6fb6", evidence: "Tăng đường huyết cũng gây giảm cân, buồn nôn và nôn, và nhìn mờ, và xu hướng nhiễm khuẩn hoặc nấm."},
    {a: "dai_thao_duong_tuyp_1", b: "khang_the_cua_tu_khang_nguyen", fact_id: "932b3fcb2ca4", evidence: "Kháng thể của tự kháng nguyên có thể phát hiện trong huyết thanh, dường như là phản ứng (không phải nguyên nhân) cho sự phá hủy tế bào beta."},
    {a: "dai_thao_duong_tuyp_1", b: "trieu_chung_cua_tang_duong_huyet", fact_id: "645c8dbb0e0f", evidence: "Bệnh nhân có đái tháo đường loại 1 thường xuất hiện với triệu chứng của tăng đường huyết và đôi khi đái tháo đường toan ceton (DKA)."},
    {a: "dai_thao_duong_tuyp_1", b: "dai_thao_duong_toan_ceton_dka", fact_id: "4dccd51e51f5", evidence: "Bệnh nhân có đái tháo đường loại 1 thường xuất hiện với triệu chứng của tăng đường huyết và đôi khi đái tháo đường toan ceton (DKA)."},
    {a: "dai_thao_duong_tuyp_1", b: "giai_doan_1", fact_id: "837de13356b1", evidence: "Bệnh đái tháo đường loại 1 tiến triển theo các giai đoạn: Giai đoạn 1: Có ≥ 2 tự kháng thể đảo tụy với lượng đường trong máu bình thường và không có triệu chứng"},
    {a: "dai_thao_duong_tuyp_1", b: "giai_doan_trang_mat", fact_id: "62c35f106bea", evidence: "Một số bệnh nhân ở giai đoạn 3 trải qua giai đoạn dài nhưng thoáng qua với mức glucose gần như bình thường sau khi khởi phát bệnh cấp tính (giai đoạn trăng mật) do quá trình tiết insulin được phục hồi một phần."},
    {a: "dai_thao_duong_tuyp_1", b: "non_oi", fact_id: "5373687b667b", evidence: "Tự đo ceton nước tiểu được khuyến cáo cho bệnh nhân đái tháo đường loại 1 nếu họ có triệu chứng, dấu hiệu, hoặc khởi phát toan ceton, như: buồn nôn, nôn ói, đau bụng, sốt, triệu chứng giống cúm và cảm lạnh, hoặc tăng đường huyết không ổn định ( > 250 đến 300 mg/dL [13,9 đến 16,7 mmol/L]) khi tự theo dõi đường huyết."},
    {a: "dai_thao_duong_tuyp_1", b: "sot", fact_id: "28cd241289cc", evidence: "Tự đo ceton nước tiểu được khuyến cáo cho bệnh nhân đái tháo đường loại 1 nếu họ có triệu chứng, dấu hiệu, hoặc khởi phát toan ceton, như: buồn nôn, nôn ói, đau bụng, sốt, triệu chứng giống cúm và cảm lạnh, hoặc tăng đường huyết không ổn định ( > 250 đến 300 mg/dL [13,9 đến 16,7 mmol/L]) khi tự theo dõi đường huyết."},
    {a: "dai_thao_duong_tuyp_1", b: "trieu_chung_giong_cum_va_cam_lanh", fact_id: "f2370bb74004", evidence: "Tự đo ceton nước tiểu được khuyến cáo cho bệnh nhân đái tháo đường loại 1 nếu họ có triệu chứng, dấu hiệu, hoặc khởi phát toan ceton, như: buồn nôn, nôn ói, đau bụng, sốt, triệu chứng giống cúm và cảm lạnh, hoặc tăng đường huyết không ổn định ( > 250 đến 300 mg/dL [13,9 đến 16,7 mmol/L]) khi tự theo dõi đường huyết."},
    {a: "dai_thao_duong_tuyp_1", b: "tang_duong_huyet_khong_on_dinh", fact_id: "cad6d0cf9b01", evidence: "Tự đo ceton nước tiểu được khuyến cáo cho bệnh nhân đái tháo đường loại 1 nếu họ có triệu chứng, dấu hiệu, hoặc khởi phát toan ceton, như: buồn nôn, nôn ói, đau bụng, sốt, triệu chứng giống cúm và cảm lạnh, hoặc tăng đường huyết không ổn định ( > 250 đến 300 mg/dL [13,9 đến 16,7 mmol/L]) khi tự theo dõi đường huyết."},
    {a: "dai_thao_duong_tuyp_1", b: "buon_non", fact_id: "8ac4911e3bd2", evidence: "Tự đo ceton nước tiểu được khuyến cáo cho bệnh nhân đái tháo đường loại 1 nếu họ có triệu chứng, dấu hiệu, hoặc khởi phát toan ceton, như: buồn nôn, nôn ói, đau bụng, sốt, triệu chứng giống cúm và cảm lạnh, hoặc tăng đường huyết không ổn định ( > 250 đến 300 mg/dL [13,9 đến 16,7 mmol/L]) khi tự theo dõi đường huyết."},
    {a: "dai_thao_duong_tuyp_1", b: "dau_bung", fact_id: "38cb34ee57fd", evidence: "Tự đo ceton nước tiểu được khuyến cáo cho bệnh nhân đái tháo đường loại 1 nếu họ có triệu chứng, dấu hiệu, hoặc khởi phát toan ceton, như: buồn nôn, nôn ói, đau bụng, sốt, triệu chứng giống cúm và cảm lạnh, hoặc tăng đường huyết không ổn định ( > 250 đến 300 mg/dL [13,9 đến 16,7 mmol/L]) khi tự theo dõi đường huyết."},
    {a: "dai_thao_duong_loai_2", b: "tang_duong_huyet", fact_id: "90c2a018c7de", evidence: "Bệnh nhân đái tháo đường loại 2 có thể xuất hiện với triệu chứng của tăng đường huyết nhưng thường không triệu chứng, và tình trạng này chỉ được phát hiện khi xét nghiệm thường xuyên."},
    {a: "dai_thao_duong_loai_2", b: "khang_insulin_ngoai_vi", fact_id: "69ca8e2b126d", evidence: "Gan kháng insulin dẫn tới không có khả năng ức chế gan sản xuất glucose, và kháng insulin ngoại vi làm giảm nhập glucose ở ngoại vi."},
    {a: "dai_thao_duong_loai_2", b: "tang_duong_huyet_luc_doi_va_sau_an", fact_id: "72a959a99293", evidence: "Phối hợp này làm tăng đường huyết lúc đói và sau ăn."},
    {a: "dai_thao_duong_loai_2", b: "suy_giam_kha_nang_dung_nap_glucose", fact_id: "77a5f8c16eb4", evidence: "Bệnh thường phát triển ở người lớn và trở nên phổ biến hơn khi tuổi càng cao; có tới một phần ba số người lớn > 65 tuổi bị suy giảm khả năng dung nạp glucose."},
    {a: "benh_than_kinh_ngoai_vi", b: "roi_loan_cam_giac_ap_luc_rung_dau_hoac_nhiet", fact_id: "44b1324bf26d", evidence: "Khám bàn chân nên thực hiện ít nhất hàng năm cho rối loạn cảm giác áp lực, rung, đau, hoặc nhiệt, những đặc điểm cho bệnh thần kinh ngoại vi."}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:HAS_SYMPTOM {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_1
}
CALL {
  WITH source
  UNWIND [
    {a: "dai_thao_duong", b: "benh_than_kinh_ngoai_vi", fact_id: "e6580f58e883", evidence: "Khám bàn chân nên thực hiện ít nhất hàng năm cho rối loạn cảm giác áp lực, rung, đau, hoặc nhiệt, những đặc điểm cho bệnh thần kinh ngoại vi."},
    {a: "dai_thao_duong", b: "bien_chung_cua_benh_tieu_duong", fact_id: "023f5b4d840c", evidence: "TIR 14 ngày > 70% có liên quan đến việc làm giảm nguy cơ biến chứng của bệnh tiểu đường và tương quan nghịch với nồng độ HbA1C ( 7 )."},
    {a: "benh_ly_than", b: "dai_thao_duong_tuyp_1", fact_id: "730a1ac71be8", evidence: "Đặc điểm chung của đái tháo đường loại 1 và loại 2"},
    {a: "dai_thao_duong_tuyp_1", b: "nhiem_toan_ceton_do_tieu_duong", fact_id: "a2ec3c69950e", evidence: "Căng thẳng sinh lý của phẫu thuật có thể làm tăng glucose huyết tương ở bệnh nhân tiểu đường và gây nhiễm toan ceton do tiểu đường ở những bệnh nhân tiểu đường loại 1."},
    {a: "suy_giam_dieu_hoa_glucose", b: "benh_tim_mach", fact_id: "68d209a30562", evidence: "Yếu tố này có liên quan đến tăng nguy cơ mắc bệnh tim mạch, nhưng các biến chứng ở mạch máu nhỏ do tiểu đường điển hình không phổ biến lắm (albumin niệu và/hoặc bệnh võng mạc phát triển ở 6% đến 10% bệnh nhân)."},
    {a: "benh_than_kinh", b: "dai_thao_duong_tuyp_1", fact_id: "ae9bd30fd64d", evidence: "Đặc điểm chung của đái tháo đường loại 1 và loại 2"},
    {a: "benh_xo_vua_tim_mach", b: "dai_thao_duong_tuyp_1", fact_id: "446cc138e611", evidence: "Đặc điểm chung của đái tháo đường loại 1 và loại 2"},
    {a: "roi_loan_dieu_hoa_glucose", b: "dai_thao_duong", fact_id: "3a141a71e173", evidence: "Tiêu chuẩn chẩn đoán đái tháo đường và rối loạn điều hòa glucose* Kiểm tra | Bình thường | Rối loạn điều hòa glucose | Bệnh tiểu đường"}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:HAS_COMPLICATION {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_2
}
CALL {
  WITH source
  UNWIND [
    {a: "dai_thao_duong", b: "cac_chuong_trinh_giao_duc_chinh_thuc_ve_benh_tieu_duong", fact_id: "7554b204d397", evidence: "Các chương trình giáo dục chính thức về bệnh tiểu đường, thường được thực hiện bởi các y tá tiểu đường và chuyên gia dinh dưỡng, thường rất hiệu quả và đã được chứng minh là cải thiện kết quả của bệnh tiểu đường."},
    {a: "dai_thao_duong", b: "dieu_chinh_can_than_cac_yeu_to_cua_benh_nhan", fact_id: "e376dc70aab1", evidence: "Chăm sóc bệnh tiểu đường cần phải có điều chỉnh cẩn thận các yếu tố của bệnh nhân, bao gồm những yếu tố liên quan đến tuổi tác và lối sống, các bệnh lý đi kèm và nhu cầu điều trị các tình trạng cấp tính hoặc tình trạng mạn tính khác."},
    {a: "dai_thao_duong", b: "kiem_soat_glucose_huyet_tuong_chat", fact_id: "e9ca58e7e197", evidence: "Nguy cơ biến chứng của đái tháo đường có thể giảm bằng kiểm soát glucose huyết tương chặt, như: HbA1C < 7%, và kiểm soát tăng huyết áp và lipid máu ."},
    {a: "dai_thao_duong", b: "kiem_soat_tang_huyet_ap", fact_id: "9fd393627516", evidence: "Nguy cơ biến chứng của đái tháo đường có thể giảm bằng kiểm soát glucose huyết tương chặt, như: HbA1C < 7%, và kiểm soát tăng huyết áp và lipid máu ."},
    {a: "dai_thao_duong_tuyp_1", b: "phat_hien_va_dieu_tri_cac_dot_ha_duong_huyet", fact_id: "1d6c96c94174", evidence: "Nhân viên nhà trường và những người chăm sóc khác phải được thông báo về bệnh và hướng dẫn về việc phát hiện và điều trị các đợt hạ đường huyết."},
    {a: "dai_thao_duong_loai_2", b: "thay_doi_loi_song", fact_id: "fdd11716bc62", evidence: "Bệnh nhân rối loạn điều hòa glucose nên được tư vấn điều chỉnh những nguy cơ phát triển đái tháo đường và tầm quan trong của thay đổi lối sống để phòng tránh đái tháo đường."},
    {a: "dai_thao_duong_loai_2", b: "giam_can_it_nhat_7_trong_luong_co_the_ban_dau", fact_id: "a94a4978bf41", evidence: "Giảm cân ít nhất 7% trọng lượng cơ thể ban đầu, kết hợp với hoạt động thể chất cường độ vừa phải (ví dụ: đi bộ 30 phút/ngày), có thể làm giảm tỷ lệ mắc bệnh tiểu đường ở những người có nguy cơ cao > 50% ( 6 )."},
    {a: "dai_thao_duong_loai_2", b: "hoat_dong_the_chat_cuong_do_vua_phai", fact_id: "83a916c320b1", evidence: "Giảm cân ít nhất 7% trọng lượng cơ thể ban đầu, kết hợp với hoạt động thể chất cường độ vừa phải (ví dụ: đi bộ 30 phút/ngày), có thể làm giảm tỷ lệ mắc bệnh tiểu đường ở những người có nguy cơ cao > 50% ( 6 )."},
    {a: "dai_thao_duong_loai_2", b: "che_do_an_kieng_va_loi_song", fact_id: "14ee0611a4fd", evidence: "Thuốc này có thể được xem xét nếu chế độ ăn kiêng và lối sống không thành công, đặc biệt ở những bệnh nhân có nguy cơ mắc bệnh tiểu đường cao nhất (chỉ số khối cơ thể ≥ 35 hoặc có tiền sử tiểu đường thai kỳ) ( 7 , 8 )."},
    {a: "dai_thao_duong_khong_on_dinh", b: "che_do_an_uong_toan_dien", fact_id: "616d9e9573f8", evidence: "Một chế độ ăn uống toàn diện, bao gồm cả thời gian của bữa ăn, nên được nhận định cho khả năng góp phần kiểm soát kém."}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:PREVENTED_BY {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_3
}
CALL {
  WITH source
  UNWIND [
    {a: "dai_thao_duong", b: "hba1c", fact_id: "784c2d348c7a", op: "<", value: 7, unit: "%", evidence: "HbA1C < 7%, và kiểm soát tăng huyết áp và lipid máu ."},
    {a: "dai_thao_duong", b: "dinh_luong_glucose_huyet_tuong", fact_id: "ce20070bd243", evidence: "Chẩn đoán bằng định lượng glucose huyết tương."},
    {a: "dai_thao_duong", b: "do_luong_glucose_huyet_tuong", fact_id: "cccc0d76c6f5", evidence: "Đái tháo đường được gợi ý bởi các triệu chứng và dấu hiệu điển hình và được xác nhận bằng cách đo lượng glucose huyết tương ( 1 , 2 )."},
    {a: "dai_thao_duong", b: "hba1c_6_5", fact_id: "c85c3ef869e4", evidence: "HbA1C ≥ 6,5% = Bệnh tiểu đường"},
    {a: "dai_thao_duong", b: "xet_nghiem_doi_chung", fact_id: "015e007b9403", evidence: "Xét nghiệm phải thực hiện ở phòng thí nghiệm lâm sàng được chứng nhận với xét nghiệm được chứng nhận và chuẩn hóa cho xét nghiệm đối chứng."},
    {a: "dai_thao_duong", b: "hba1c_dau_ngon_tai_giuong", fact_id: "cff71b1dcd3b", evidence: "Không nên sử dụng các chỉ số đo HbA1C đầu ngón tại giường cho mục đích chẩn đoán, mặc dù các chỉ số này có thể được sử dụng để theo dõi việc kiểm soát bệnh tiểu đường."},
    {a: "dai_thao_duong", b: "do_luong_glucose_trong_nuoc_tieu", fact_id: "5e0c6a122a55", evidence: "Đo lượng glucose trong nước tiểu, không sử dụng để chẩn đoán và theo dõi vì không nhạy và không đặc hiệu."},
    {a: "dai_thao_duong", b: "fpg", fact_id: "810d1bdb681a", evidence: "FPG (mg/dL [mmol/L]) | < 100 ( < 5,6) | 100–125 (5,6–6,9) | ≥ 126 ( ≥ 7,0)"},
    {a: "dai_thao_duong", b: "ogtt", fact_id: "c9e6e7852ac4", evidence: "OGTT (mg/dL [mmol/L]) | < 140 ( < 7,8) | 140–199 (7,8–11,0) | ≥ 200 ( ≥ 11,1)"},
    {a: "dai_thao_duong", b: "glucose_ngau_nhien", fact_id: "557dafd3450d", evidence: "Glucose ngẫu nhiên (mg/dL [mmol/L]) | < 200 ( < 11,1) | — | > 200 ( > 11,1) ở một bệnh nhân có các triệu chứng"},
    {a: "dai_thao_duong", b: "danh_gia_chuc_nang_than", fact_id: "ce4150efa2e5", evidence: "Xét nghiệm nước tiểu tại chỗ hoặc 24 giờ được chỉ định hàng năm để phát hiện albumin niệu và creatinine huyết thanh nên được đo hàng năm để đánh giá chức năng thận."},
    {a: "dai_thao_duong", b: "bong_da_day_duoc_cay_ghep", fact_id: "a845c90d6b0f", evidence: "Các thiết bị y tế, bao gồm bóng dạ dày được cấy ghép, máy kích thích dây thần kinh phế vị và liệu pháp hút dịch dạ dày cũng có sẵn, nhưng việc sử dụng các thiết bị này vẫn còn hạn chế do chi phí cao và dữ liệu hạn chế ở bệnh nhân tiểu đường."},
    {a: "dai_thao_duong", b: "may_kich_thich_day_than_kinh_phe_vi", fact_id: "d4be86c7695e", evidence: "Các thiết bị y tế, bao gồm bóng dạ dày được cấy ghép, máy kích thích dây thần kinh phế vị và liệu pháp hút dịch dạ dày cũng có sẵn, nhưng việc sử dụng các thiết bị này vẫn còn hạn chế do chi phí cao và dữ liệu hạn chế ở bệnh nhân tiểu đường."},
    {a: "dai_thao_duong", b: "lieu_phap_hut_dich_da_day", fact_id: "b5eb7b2ff6ea", evidence: "Các thiết bị y tế, bao gồm bóng dạ dày được cấy ghép, máy kích thích dây thần kinh phế vị và liệu pháp hút dịch dạ dày cũng có sẵn, nhưng việc sử dụng các thiết bị này vẫn còn hạn chế do chi phí cao và dữ liệu hạn chế ở bệnh nhân tiểu đường."},
    {a: "dai_thao_duong", b: "phau_thuat", fact_id: "c4905c0ad95e", evidence: "Điều trị béo phì bằng phẫu thuật , chẳng hạn như cắt vạt dạ dày hoặc bắc cầu dạ dày, cũng dẫn đến giảm cân và cải thiện việc kiểm soát glucose (không phụ thuộc vào giảm cân) và giảm nguy cơ tim mạch ở bệnh nhân đái tháo đường và nên được khuyến nghị cho những bệnh nhân được lựa chọn thích hợp."},
    {a: "dai_thao_duong", b: "theo_doi_duong_huyet_lien_tuc_cgm", fact_id: "8e277dbcb54b", evidence: "Với theo dõi đường huyết liên tục (CGM), thời gian 14 ngày trong khoảng (TIR) > 70% (khoảng đường huyết mục tiêu 70 đến 180 mg/mL [3,9 đến 9,9 mmol/L])"},
    {a: "dai_thao_duong", b: "hba1c_7", fact_id: "1e830b590824", evidence: "HbA1C < 7%"},
    {a: "dai_thao_duong", b: "hba1c_6_5__test", fact_id: "e1b8fdccd4d0", evidence: "Các bác sĩ lâm sàng cũng có thể đề nghị các mục tiêu đường huyết chặt chẽ hơn (ví dụ: HbA1C < 6,5%) ở một số bệnh nhân được chọn nếu những mục tiêu này có thể đạt được mà không bị hạ đường huyết."},
    {a: "dai_thao_duong", b: "theo_doi_duong_huyet_lien_tuc", fact_id: "f3d9d28f7a4d", evidence: "Nồng độ glucose thường được xác định bằng cách theo dõi tại nhà đường huyết mao mạch (ví dụ: từ xét nghiệm đường huyết đầu ngón tay) hoặc theo dõi đường huyết liên tục."},
    {a: "dai_thao_duong", b: "que_thu", fact_id: "2fce0f953c76", evidence: "Hầu như tất cả đều cần que thử và phương tiện để chích da và lấy mẫu máu."},
    {a: "dai_thao_duong", b: "phuong_tien_de_chich_da_va_lay_mau_mau", fact_id: "6a9b10ef0056", evidence: "Hầu như tất cả đều cần que thử và phương tiện để chích da và lấy mẫu máu."},
    {a: "dai_thao_duong", b: "cgm", fact_id: "df6f56296c62", evidence: "Đối với bệnh nhân tiểu đường sử dụng CGM, TIR được định nghĩa là tỷ lệ phần trăm thời gian đo đường huyết trên CGM nằm trong phạm vi đường huyết mục tiêu (70 đến 180 mg/mL [3,9 đến 9,9 mmol/L]) trong 14 ngày."},
    {a: "dai_thao_duong", b: "fructosamine", fact_id: "b69adcb134cf", evidence: "Fructosamine, chủ yếu là albumin được glycosyl hóa nhưng cũng bao gồm các protein được glycosyl hóa khác, phản ánh việc kiểm soát glucose trong 1 đến 2 tuần trước đó."},
    {a: "dai_thao_duong", b: "lieu_phap_bom_insulin_vong_kin", fact_id: "f9ee5efea134", evidence: "Theo dõi đường huyết liên tục với báo động và liệu pháp bơm insulin vòng kín tăng cường cảm biến hoặc hỗn hợp là những công cụ hữu ích ở những người dao động giữa hạ đường huyết và tăng đường huyết."},
    {a: "dai_thao_duong", b: "dung_dich_dextrose_duong_tinh_mach", fact_id: "8bc344eb9ad9", evidence: "Có thể truyền insulin đường tĩnh mạch cùng lúc với dung dịch dextrose đường tĩnh mạch để duy trì lượng đường trong máu."},
    {a: "dai_thao_duong", b: "phac_do_gik", fact_id: "73ef90b573e8", evidence: "Một cách tiếp cận là phối hợp glucose, insulin và kali trong cùng một túi truyền (phác đồ GIK), ví dụ, bằng cách phối hợp 10% dextrose với 10 mEq (10 mmol) kali và 15 đơn vị insulin trong túi 500 mL."},
    {a: "dai_thao_duong", b: "muoi_phan_tram_dextrose", fact_id: "276a40f483e6", evidence: "Mười phần trăm dextrose cũng có thể được sử dụng."},
    {a: "dai_thao_duong", b: "tang_nong_do_glucose_huyet_tuong_luc_doi", fact_id: "8828f581f9a5", evidence: "Chẩn đoán bằng cách tăng nồng độ glucose huyết tương lúc đói và / hoặc hemoglobin A1C tăng và / hoặc giá trị 2 giờ tăng cao trên xét nghiệm dung nạp glucose qua đường uống."},
    {a: "tien_dai_thao_duong", b: "duong_huyet_luc_doi", fact_id: "32aaf5c8ef0c", op: "range", value: 250, value_max: 300, unit: "mg/dl", evidence: "buồn nôn, nôn ói, đau bụng, sốt, triệu chứng giống cúm và cảm lạnh, hoặc tăng đường huyết không ổn định ( > 250 đến 300 mg/dL [13,9 đến 16,7 mmol/L]) khi tự theo dõi đường huyết."},
    {a: "tien_dai_thao_duong", b: "hba1c_5_7_to_6_4", fact_id: "53f46d2eac79", evidence: "HbA1c 5,7 to 6,4% = tiền đái tháo đường hoặc nguy cơ đái tháo đường"},
    {a: "dai_thao_duong_tuyp_1", b: "bac_si", fact_id: "914fdc5e83e4", evidence: "Tư vấn dinh dưỡng với chuyên gia dinh dưỡng nên bổ sung cho tư vấn của bác sĩ; bệnh nhân và bất kỳ người nào chuẩn bị bữa ăn cho bệnh nhân phải có mặt."},
    {a: "dai_thao_duong_tuyp_1", b: "sang_loc_bien_chung_dai_thao_duong", fact_id: "cc54a59b6871", evidence: "Tất cả bệnh nhân với đái tháo đường loại 1 nên bắt đầu sàng lọc biến chứng đái tháo đường sau thời điểm chẩn đoán 5 năm."},
    {a: "dai_thao_duong_tuyp_1", b: "chuyen_gia_dinh_duong", fact_id: "9983f019a01b", evidence: "Tư vấn dinh dưỡng với chuyên gia dinh dưỡng nên bổ sung cho tư vấn của bác sĩ; bệnh nhân và bất kỳ người nào chuẩn bị bữa ăn cho bệnh nhân phải có mặt."},
    {a: "benh_tim_mach", b: "ecg_co_so", fact_id: "e602673b6af7", evidence: "Cần phải xét nghiệm bệnh tim mạch . Nhiều bác sĩ xem xét ECG cơ sở quan trọng cho phát hiện nguy cơ bệnh tim."},
    {a: "benh_tim_mach", b: "bai_tap_kiem_tra_stress", fact_id: "64df45da4823", evidence: "Bệnh nhân đã biết hoặc nghi ngờ bệnh tim mạch có thể có lợi ích từ bài tập kiểm tra stress trước khi bắt đầu chương trình luyện tập."},
    {a: "dai_thao_duong_loai_2", b: "truyen_tinh_mach_dung_dich_dextrose", fact_id: "2431cb56921f", evidence: "Có thể bắt đầu truyền tĩnh mạch dung dịch dextrose trước khi phẫu thuật với tốc độ 75 đến 150 mL/giờ và được chuẩn độ để duy trì đường huyết bình thường."},
    {a: "dai_thao_duong_loai_2", b: "dinh_luong_ceton", fact_id: "a0d2795fed5d", evidence: "Tiếp cận này cũng có thể sử dụng cho insulin điều trị bệnh nhân đái tháo đường loại 2, nhưng có thể bỏ qua định lượng ceton thường xuyên."},
    {a: "dai_thao_duong_dm", b: "cac_giao_thuc_truyen_insulin_va_hoac_cac_thuat_toan_vi_tinh_hoa", fact_id: "ec9cab85bf93", evidence: "Ở những bệnh nhân bị bệnh nặng hoặc bệnh nhân sau phẫu thuật đang ở trong phòng chăm sóc đặc biệt, các giao thức truyền insulin và/hoặc các thuật toán vi tính hóa có thể được sử dụng để điều chỉnh lượng insulin nhỏ giọt nhằm duy trì lượng đường trong máu bình thường."},
    {a: "dai_thao_duong_khong_on_dinh", b: "bao_quan", fact_id: "d38a05202f42", evidence: "Tiếp cận ban đầu là xem xét cẩn thận kĩ thuật tự chăm sóc, gồm bảo quản, tiêm insulin và thử glucose máu."},
    {a: "dai_thao_duong_khong_on_dinh", b: "tiem_insulin", fact_id: "d70c6bdf0580", evidence: "Tiếp cận ban đầu là xem xét cẩn thận kĩ thuật tự chăm sóc, gồm bảo quản, tiêm insulin và thử glucose máu."},
    {a: "dai_thao_duong_khong_on_dinh", b: "thu_glucose_mau", fact_id: "18d2925cd679", evidence: "Tiếp cận ban đầu là xem xét cẩn thận kĩ thuật tự chăm sóc, gồm bảo quản, tiêm insulin và thử glucose máu."},
    {a: "dai_thao_duong_khong_on_dinh", b: "kham_lam_sang", fact_id: "9afdc617dcfa", evidence: "Bệnh lý nền cần được loại trừ bằng khám lâm sàng và xét nghiệm thích hợp."},
    {a: "dai_thao_duong_khong_on_dinh", b: "xet_nghiem_thich_hop", fact_id: "60f6db7a95d2", evidence: "Bệnh lý nền cần được loại trừ bằng khám lâm sàng và xét nghiệm thích hợp."},
    {a: "benh_tieu_duong_loai_2", b: "do_nong_do_glucose_huyet_tuong", fact_id: "7667515c8cee", evidence: "Hầu hết các loại thuốc uống, bao gồm sulfonylureas và metformin, nên được ngừng sử dụng vào ngày phẫu thuật và nên đo nồng độ glucose huyết tương trước và sau phẫu thuật và 6 giờ một lần trong khi bệnh nhân được truyền dịch đường tĩnh mạch."}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:DIAGNOSED_BY {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_4
}
CALL {
  WITH source
  UNWIND [
    {a: "dai_thao_duong", b: "insulin", fact_id: "ba1aa1ba6437", evidence: "Điều trị bằng chế độ ăn kiêng, tập thể dục và dùng thuốc làm giảm lượng glucose, bao gồm insulin , thuốc hạ đường huyết đường uống và thuốc tiêm không chứa insulin ."},
    {a: "dai_thao_duong", b: "giam_can", fact_id: "915db5cdb677", evidence: "Các yếu tố chính của điều trị cho tất cả bệnh nhân là giáo dục bệnh nhân, ăn kiêng, tập thể dục, giảm cân và theo dõi kiểm soát đường huyết."},
    {a: "dai_thao_duong", b: "thuoc_ha_duong_huyet", fact_id: "ceba24b96b2f", evidence: "Điều trị bằng chế độ ăn kiêng, tập thể dục và dùng thuốc làm giảm lượng glucose, bao gồm insulin , thuốc hạ đường huyết đường uống và thuốc tiêm không chứa insulin ."},
    {a: "dai_thao_duong", b: "thuoc_chu_van_thu_the_glp1", fact_id: "d4d3a93844d0", evidence: "Ở những người mắc bệnh tiểu đường và béo phì , bác sĩ nên kê đơn thuốc hạ đường huyết để thúc đẩy giảm cân (ví dụ: thuốc chủ vận thụ thể GLP1, thuốc ức chế SGLT-2 hoặc thuốc chủ vận incretin kép) hoặc thuốc có tác dụng trung tính về cân nặng (ví dụ: thuốc ức chế dipeptidyl peptidase-4, metformin), nếu có thể (để biết chi tiết, xem Thuốc điều trị bệnh tiểu đường )."},
    {a: "dai_thao_duong", b: "thuoc_uc_che_sglt_2", fact_id: "5c844fd60bd3", evidence: "Ở những người mắc bệnh tiểu đường và béo phì , bác sĩ nên kê đơn thuốc hạ đường huyết để thúc đẩy giảm cân (ví dụ: thuốc chủ vận thụ thể GLP1, thuốc ức chế SGLT-2 hoặc thuốc chủ vận incretin kép) hoặc thuốc có tác dụng trung tính về cân nặng (ví dụ: thuốc ức chế dipeptidyl peptidase-4, metformin), nếu có thể (để biết chi tiết, xem Thuốc điều trị bệnh tiểu đường )."},
    {a: "dai_thao_duong", b: "thuoc_chu_van_incretin_kep", fact_id: "c574b65e8f85", evidence: "Ở những người mắc bệnh tiểu đường và béo phì , bác sĩ nên kê đơn thuốc hạ đường huyết để thúc đẩy giảm cân (ví dụ: thuốc chủ vận thụ thể GLP1, thuốc ức chế SGLT-2 hoặc thuốc chủ vận incretin kép) hoặc thuốc có tác dụng trung tính về cân nặng (ví dụ: thuốc ức chế dipeptidyl peptidase-4, metformin), nếu có thể (để biết chi tiết, xem Thuốc điều trị bệnh tiểu đường )."},
    {a: "dai_thao_duong", b: "thuoc_uc_che_dipeptidyl_peptidase_4", fact_id: "55a929826a73", evidence: "Ở những người mắc bệnh tiểu đường và béo phì , bác sĩ nên kê đơn thuốc hạ đường huyết để thúc đẩy giảm cân (ví dụ: thuốc chủ vận thụ thể GLP1, thuốc ức chế SGLT-2 hoặc thuốc chủ vận incretin kép) hoặc thuốc có tác dụng trung tính về cân nặng (ví dụ: thuốc ức chế dipeptidyl peptidase-4, metformin), nếu có thể (để biết chi tiết, xem Thuốc điều trị bệnh tiểu đường )."},
    {a: "dai_thao_duong", b: "semaglutide_2_4_mg", fact_id: "f784d2069cc6", evidence: "Hai thuốc chủ vận thụ thể GLP-1 được sử dụng để giảm cân ở liều cao hơn (semaglutide 2,4 mg, liraglutide 3 mg) có liên quan đến việc giảm cân đáng kể ngay cả ở liều được sử dụng để điều trị bệnh tiểu đường."},
    {a: "dai_thao_duong", b: "liraglutide_3_mg", fact_id: "28cf744cdc27", evidence: "Hai thuốc chủ vận thụ thể GLP-1 được sử dụng để giảm cân ở liều cao hơn (semaglutide 2,4 mg, liraglutide 3 mg) có liên quan đến việc giảm cân đáng kể ngay cả ở liều được sử dụng để điều trị bệnh tiểu đường."},
    {a: "dai_thao_duong", b: "orlistat", fact_id: "c8c97f458794", evidence: "Các loại thuốc giảm cân khác, bao gồm orlistat, phentermine/topiramate và naltrexone/bupropion, có thể hữu ích ở những bệnh nhân được chọn trong khuôn khổ của chương trình giảm cân toàn diện."},
    {a: "dai_thao_duong", b: "phentermine_topiramate", fact_id: "4c70f44c11d7", evidence: "Các loại thuốc giảm cân khác, bao gồm orlistat, phentermine/topiramate và naltrexone/bupropion, có thể hữu ích ở những bệnh nhân được chọn trong khuôn khổ của chương trình giảm cân toàn diện."},
    {a: "dai_thao_duong", b: "naltrexone_bupropion", fact_id: "43abe0cd4bef", evidence: "Các loại thuốc giảm cân khác, bao gồm orlistat, phentermine/topiramate và naltrexone/bupropion, có thể hữu ích ở những bệnh nhân được chọn trong khuôn khổ của chương trình giảm cân toàn diện."},
    {a: "dai_thao_duong", b: "thuoc_uc_che_lipase_tai_ruot", fact_id: "9fb8065d924e", evidence: "Orlistat, thuốc ức chế lipase tại ruột, giảm hấp thu thức ăn chứa mỡ ; thuốc giảm nồng độ lipid huyết thanh và thúc đẩy giảm cân."},
    {a: "dai_thao_duong", b: "thuoc_phoi_hop_lam_giam_cam_giac_them_an", fact_id: "3bc9664b38f5", evidence: "Phentermine/topiramate là một loại thuốc phối hợp làm giảm cảm giác thèm ăn thông qua nhiều cơ chế trong não."},
    {a: "dai_thao_duong", b: "hydrogel_uong_co_chua_cellulose_va_axit_xitric", fact_id: "4e3f14dee744", evidence: "Một loại hydrogel uống có chứa cellulose và axit xitric khiến bệnh nhân cảm thấy no và ăn ít hơn có thể giúp giảm cân ở mức độ khiêm tốn ở những bệnh nhân tiền tiểu đường và tiểu đường."},
    {a: "dai_thao_duong", b: "insulin_nen", fact_id: "52028103c72c", evidence: "Hầu hết bệnh nhân nội trú có thể phù hợp điều trị với insulin nền kèm theo hoặc không bổ sung insulin tác dụng nhanh."},
    {a: "dai_thao_duong", b: "uc_che_dipeptidyl_peptidase_4", fact_id: "37503819e591", evidence: "Ức chế Dipeptidyl peptidase-4 tương đối an toàn, thậm chí trong bệnh nhân suy thận, và thuốc cũng được sử dụng cho giảm glucose sau ăn."},
    {a: "dai_thao_duong", b: "insulin_duoi_da", fact_id: "a817efceb8b6", evidence: "Một số bác sĩ ưu tiên dùng insulin dưới da hoặc dạng hít trong ngày phẫu thuật hơn là sử dụng insulin truyền tĩnh mạch."},
    {a: "dai_thao_duong", b: "lieu_insulin", fact_id: "27976b9135df", evidence: "Liều insulin được điều chỉnh mức tăng 5 đơn vị mỗi lần."},
    {a: "dai_thao_duong", b: "ty_le_insulin", fact_id: "f4dab440b38e", evidence: "Tỷ lệ insulin có thể cần phải giảm đối với những bệnh nhân mắc bệnh tiểu đường loại 1 nhạy cảm với insulin hơn và tăng lên đối với những bệnh nhân mắc bệnh tiểu đường loại 2 kháng insulin hơn."},
    {a: "dai_thao_duong", b: "tap_luyen_the_duc", fact_id: "0e68810122a6", evidence: "Điều trị bằng chế độ ăn kiêng, tập thể dục và dùng thuốc làm giảm lượng glucose, bao gồm insulin , thuốc hạ đường huyết đường uống và thuốc tiêm không chứa insulin ."},
    {a: "dai_thao_duong", b: "che_do_an_kieng", fact_id: "0eda338a941d", evidence: "Điều trị bằng chế độ ăn kiêng, tập thể dục và dùng thuốc làm giảm lượng glucose, bao gồm insulin , thuốc hạ đường huyết đường uống và thuốc tiêm không chứa insulin ."},
    {a: "dai_thao_duong", b: "giao_duc_benh_nhan", fact_id: "6bde0baa3aef", evidence: "Các yếu tố chính của điều trị cho tất cả bệnh nhân là giáo dục bệnh nhân, ăn kiêng, tập thể dục, giảm cân và theo dõi kiểm soát đường huyết."},
    {a: "dai_thao_duong", b: "an_kieng", fact_id: "41743e6f7e58", evidence: "Các yếu tố chính của điều trị cho tất cả bệnh nhân là giáo dục bệnh nhân, ăn kiêng, tập thể dục, giảm cân và theo dõi kiểm soát đường huyết."},
    {a: "dai_thao_duong", b: "dieu_chinh_lieu_insulin", fact_id: "8e78825f3802", evidence: "Hầu hết bệnh nhân tiểu đường loại 1 có thể được dạy cách điều chỉnh liều insulin của họ dựa trên mức đường huyết và lượng carbohydrate."},
    {a: "dai_thao_duong", b: "thuc_pham_nguyen_chat", fact_id: "55e2e3100a32", evidence: "Bệnh nhân nên được giáo dục về việc áp dụng chế độ ăn nhiều thực phẩm nguyên chất hơn là thực phẩm chế biến sẵn."},
    {a: "dai_thao_duong", b: "chat_xo_vitamin_khoang_chat", fact_id: "1cf83d7e6660", evidence: "Carbohydrate phải có chất lượng cao và phải chứa đủ lượng chất xơ, vitamin, khoáng chất và ít đường, chất béo và natri bổ sung."},
    {a: "dai_thao_duong", b: "an_it_hoac_rat_it_carbohydrate", fact_id: "93d1901ba81a", evidence: "Một số người trưởng thành có thể giảm nồng độ đường huyết và giảm thuốc hạ đường huyết bằng cách tuân theo kế hoạch ăn ít hoặc rất ít carbohydrate, mặc dù việc duy trì chế độ ăn như vậy có thể khó khăn và lợi ích có thể không duy trì lâu dài."},
    {a: "dai_thao_duong", b: "kiem_soat_tinh_trang_tang_duong_huyet", fact_id: "f6438f8b855b", evidence: "Mục tiêu của điều trị bệnh tiểu đường là kiểm soát tình trạng tăng đường huyết để làm giảm các triệu chứng và ngăn ngừa các biến chứng đồng thời giảm thiểu các đợt hạ đường huyết."},
    {a: "dai_thao_duong", b: "nhap_vien", fact_id: "0cc1a8f8d157", evidence: "Đái tháo đường có thể là lý do chính khiến bệnh nhân phải nhập viện hoặc có thể đi kèm với các bệnh khác cần được điều trị nội trú."},
    {a: "dai_thao_duong", b: "truyen_insulin_lien_tuc", fact_id: "4d787ea2550c", evidence: "Đối với những bệnh nhân trải qua một cuộc phẫu thuật kéo dài hoặc cuộc phẫu thuật lớn, ưu tiên truyền insulin liên tục, đặc biệt vì nhu cầu về insulin có thể tăng lên do căng thẳng của cuộc phẫu thuật."},
    {a: "dai_thao_duong", b: "truyen_insulin_va_dextrose_rieng_biet", fact_id: "e139b2d22ccb", evidence: "Một cách tiếp cận phổ biến hơn ở Hoa Kỳ là truyền insulin và dextrose riêng biệt."},
    {a: "dai_thao_duong", b: "truyen_insulin", fact_id: "d068334d4979", evidence: "Điều quan trọng, đặc biệt ở những bệnh nhân mắc bệnh tiểu đường loại 1, là tiếp tục truyền insulin để tránh phát triển bệnh nhiễm toan do tiểu đường."},
    {a: "dai_thao_duong", b: "trang_day_truyen_tinh_mach_bang_insulin", fact_id: "95ba22a1237a", evidence: "Insulin hấp phụ vào dây truyền tĩnh mạch dẫn đến tác động không ổn định, có thể hạn chế hiện tượng này bằng cách tráng dây truyền tĩnh mạch bằng insulin ."},
    {a: "dai_thao_duong", b: "dieu_chinh_insulin_dua_tren_nong_glucose_huyet_tuong", fact_id: "a1aa8b79e2e4", evidence: "Truyền Insulin vẫn được tiếp tục khi chuyển qua phòng hồi phục, với điều chỉnh insulin dựa trên nồng glucose huyết tương trong phòng phục hồi và khoảng 1-2 giờ sau."},
    {a: "dai_thao_duong", b: "diet", fact_id: "a8b503e479dc", evidence: "Treat with diet, exercise, weight loss, and insulin , and/or oral or injectable antihyperglycemic medications."},
    {a: "dai_thao_duong", b: "exercise", fact_id: "484ca8af2f7e", evidence: "Treat with diet, exercise, weight loss, and insulin , and/or oral or injectable antihyperglycemic medications."},
    {a: "dai_thao_duong", b: "weight_loss", fact_id: "4d2064ca8ed3", evidence: "Treat with diet, exercise, weight loss, and insulin , and/or oral or injectable antihyperglycemic medications."},
    {a: "dai_thao_duong_tuyp_1", b: "insulin_tac_dung_dai_hon", fact_id: "c89df9ec77c9", evidence: "Trong liệu pháp liều tấn công cơ bản, insulin tác dụng dài hơn (hoặc truyền insuli n tác dụng nhanh dưới da liên tục bằng máy bơm) được sử dụng để mô phỏng sản xuất insulin cơ bản ngăn chặn sản xuất glucose ở gan, đặc biệt là ở trạng thái đói và insulin tác dụng nhanh hơn được sử dụng trước bữa ăn để kiểm soát lượng đường sau ăn."},
    {a: "dai_thao_duong_tuyp_1", b: "insulin_tac_dung_nhanh", fact_id: "f556cf0ff4c8", evidence: "Insulin theo thang trượt là một chiến lược trong đó các liều lượng khác nhau của insulin tác dụng nhanh được cho dùng trước bữa ăn và trước khi đi ngủ tùy thuộc vào mức đường huyết trong huyết tương của bệnh nhân."},
    {a: "dai_thao_duong_tuyp_1", b: "insulin_tiem_duoi_da", fact_id: "a2a16a7221a9", evidence: "Đối với các thủ thuật trong thời gian ngắn hơn, có thể sử dụng insulin tiêm dưới da."},
    {a: "dai_thao_duong_tuyp_1", b: "insulin_tac_dung_trung_gian", fact_id: "e0ddbe411dcb", evidence: "Ở bệnh nhân đái tháo đường loại 1, 1/2 đến 2/3 liều thông thường buổi sáng của insulin tác dụng trung gian hoặc 70 đến 80% liều của insulin tác dụng kéo dài (glargine hoặc detemir) có thể sử dụng buổi tối hoặc sáng trước phẫu thuật (vào thời điểm thường dùng insulin tác dụng kéo dài)."},
    {a: "dai_thao_duong_tuyp_1", b: "insulin_tac_dung_keo_dai", fact_id: "57df1d802053", evidence: "Ở bệnh nhân đái tháo đường loại 1, 1/2 đến 2/3 liều thông thường buổi sáng của insulin tác dụng trung gian hoặc 70 đến 80% liều của insulin tác dụng kéo dài (glargine hoặc detemir) có thể sử dụng buổi tối hoặc sáng trước phẫu thuật (vào thời điểm thường dùng insulin tác dụng kéo dài)."},
    {a: "dai_thao_duong_tuyp_1", b: "tinh_luong_carbohydrate", fact_id: "49131b950cfa", evidence: "Bệnh nhân đái tháo đường loại 1 nên sử dụng tính lượng carbohydrate hoặc hệ thống chuyển đổi carbohydrate để phù hợp giữa liều insulin với lượng carbonhydrate ăn vào và bổ sung insulin thuận tiện."},
    {a: "dai_thao_duong_tuyp_1", b: "dem_luong_carbohydrate_trong_bua_an", fact_id: "86a1806921c8", evidence: "“Đếm” lượng carbohydrate trong bữa ăn được thực hiện để tính toán liều insulin trước bữa ăn."},
    {a: "dai_thao_duong_tuyp_1", b: "bom_insulin", fact_id: "808ec2d76286", evidence: "Trẻ em với đái tháo đường loại 1 đòi hỏi bổ sung thay thế insulin sinh lí như người lớn, và phác đồ điều trị tương tự, gồm bơm insulin ."},
    {a: "dai_thao_duong_tuyp_1", b: "thu_glucose", fact_id: "29d836faef67", evidence: "Hầu hết trẻ nhỏ có thể được dạy để chủ động trong tự chăm sóc bản thân, gồm thử glucose và tiêm insulin ."},
    {a: "dai_thao_duong_tuyp_1", b: "bao_ton_chuc_nang_te_bao_beta", fact_id: "3cb31dd18131", evidence: "Antithymocyte globulin (ATG), thuốc ức chế TNF-alpha (yếu tố hoại tử khối u-alpha) và abatacept (CTLA-4-Ig) đã cho thấy một số hứa hẹn trong việc bảo tồn chức năng tế bào beta ở bệnh đái tháo đường loại 1 mới khởi phát và đang được nghiên cứu ( 3 , 4 )."},
    {a: "dai_thao_duong_loai_2", b: "insulin_tac_dung_nhanh", fact_id: "29ef639c927e", evidence: "Truyền glucose được liên tục, và insulin tác dụng nhanh hoặc thường được tiêm dưới da mỗi 4-6 giờ là cần thiết để duy trì glucose huyết tương giữa 100 và 200 mg/dL (5,5 và 11,1 mmol/L) cho tới khi bệnh nhân có thể chuyển ăn đường miệng và trở lại phác đồ insulin thông thường."},
    {a: "dai_thao_duong_loai_2", b: "insulin_tac_dung_trung_gian", fact_id: "142ba4ce95b9", evidence: "Liều bổ sung insulin tác dụng trung gian hoặc kéo dài nên được cho nếu có sự chậm trễ đáng kể ( > 24 giờ) trong tiếp tục phác đồ thông thường."},
    {a: "dai_thao_duong_loai_2", b: "insulin_co_ban", fact_id: "e6becdedfd16", evidence: "Bệnh nhân tiểu đường loại 2 đang sử dụng insulin nên được cung cấp 50% liều insulin cơ bản của họ vào buổi tối hoặc buổi sáng trước khi phẫu thuật."},
    {a: "dai_thao_duong_loai_2", b: "kiem_soat_can_nang", fact_id: "05996e2c1a1e", evidence: "Trẻ em đái tháo đường loại 2 yêu cầu chú ý đến chế độ ăn uống và kiểm soát cân nặng và nhận thức và quản lý của rối loạn lipid máu và tăng huyết áp như người lớn."},
    {a: "dai_thao_duong_loai_2", b: "che_do_an_uong", fact_id: "aeeb83da27d6", evidence: "Trẻ em đái tháo đường loại 2 yêu cầu chú ý đến chế độ ăn uống và kiểm soát cân nặng và nhận thức và quản lý của rối loạn lipid máu và tăng huyết áp như người lớn."},
    {a: "dai_thao_duong_loai_2", b: "dieu_chinh_loi_song", fact_id: "0d186ad58f02", evidence: "Hầu hết trẻ em mắc bệnh tiểu đường loại 2 đều bị béo phì, vì vậy việc điều chỉnh lối sống là nền tảng của liệu pháp điều trị."},
    {a: "dai_thao_duong_loai_2", b: "dieu_tri_bang_thuoc", fact_id: "3655c42ad726", evidence: "Điều trị bằng thuốc cũng có thể được chỉ định."},
    {a: "dai_thao_duong_dm", b: "insulin", fact_id: "25a5d889ad7d", evidence: "Những bệnh nhân bị bệnh nặng, đặc biệt là những bệnh nhân được điều trị bằng glucocorticoid hoặc thuốc ép và những người nhận dinh dưỡng toàn phần qua đường tĩnh mạch (TPN), có thể cần liều insulin rất cao ( > 5 đến 10 đơn vị/giờ) do kháng insulin."},
    {a: "dai_thao_duong_dm", b: "metformin", fact_id: "b0bdfae010b2", evidence: "Bệnh nhân bị bệnh tiểu đường loại 2 và lượng đường huyết tăng nhẹ có thể được chỉ định thử nghiệm chế độ ăn kiêng và tập thể dục, sau đó dùng thuốc hạ đường huyết không insulin (thường là metformin) nếu thay đổi lối sống không đủ."},
    {a: "dai_thao_duong_dm", b: "lieu_phap_insulin", fact_id: "3f46b3d2e7ea", evidence: "Điều trị kết hợp sớm và/hoặc liệu pháp insulin nên được bắt đầu ở những bệnh nhân có mức tăng glucose đáng kể hơn khi được chẩn đoán hoặc có nồng độ HbA1C cao hơn mục tiêu 1,5 đến 2,0%."},
    {a: "dai_thao_duong_dm", b: "thuoc_chu_van_thu_the_peptide_1_giong_glucagon_glp1", fact_id: "4a2e0a897a73", evidence: "Thuốc chủ vận thụ thể peptide-1 giống glucagon (GLP1) là liệu pháp bước hai hiệu quả sau metformin và có thể hiệu quả hơn insulin hoặc như một liệu pháp bổ sung cho liệu pháp insulin trong bệnh tiểu đường loại 2."},
    {a: "dai_thao_duong_dm", b: "tirzepatide", fact_id: "02dcc8acd1fe", evidence: "Bệnh nhân béo phì cũng có thể được hưởng lợi từ tác dụng giảm cân của liệu pháp thuốc chủ vận thụ thể GLP-1 hoặc từ việc sử dụng tirzepatide, một polypeptit insulinotropic kép phụ thuộc glucose (GIP) và thuốc chủ vận thụ thể GLP-1."},
    {a: "dai_thao_duong_dm", b: "lieu_phap_insulin_chuyen_sau", fact_id: "dd138f16768c", evidence: "Khuyến nghị sử dụng CGM cho tất cả bệnh nhân được điều trị bằng liệu pháp insulin chuyên sâu và có thể sử dụng thiết bị một cách an toàn ( 6 )."},
    {a: "benh_tim_mach_do_xo_vua_dong_mach", b: "thuoc_uc_che_kenh_dong_van_natri_glucose_2_sglt2", fact_id: "39d3abd10080", evidence: "Ở những bệnh nhân mắc bệnh tim mạch do xơ vữa động mạch, thuốc ức chế kênh đồng vận natri/glucose 2 (SGLT2) hoặc thuốc chủ vận thụ thể GLP-1 có thể được khuyến nghị vì có bằng chứng cho thấy các nhóm thuốc này làm giảm các biến cố tim mạch bất lợi nghiêm trọng (ví dụ: nhồi máu cơ tim, đột quỵ) và tử vong."},
    {a: "benh_nhan_bi_tang_duong_huyet_nang", b: "insulin", fact_id: "91b945484158", evidence: "Bệnh nhân bị tăng đường huyết nặng có thể đáp ứng tốt hơn với liệu pháp sau khi mức đường huyết được bình thường trở lại khi điều trị bằng insulin ."},
    {a: "benh_tieu_duong_loai_2", b: "insulin", fact_id: "78fa00bcd39d", evidence: "Hầu hết bệnh nhân bị bệnh tiểu đường loại 2 chỉ được điều trị bằng thuốc hạ đường huyết đường uống đều duy trì nồng độ glucose chấp nhận được khi nhịn ăn và có thể không cần dùng insulin trong giai đoạn chu phẫu."},
    {a: "benh_tieu_duong_loai_2", b: "sulfonylureas", fact_id: "ce24d2e14528", evidence: "Hầu hết các loại thuốc uống, bao gồm sulfonylureas và metformin, nên được ngừng sử dụng vào ngày phẫu thuật và nên đo nồng độ glucose huyết tương trước và sau phẫu thuật và 6 giờ một lần trong khi bệnh nhân được truyền dịch đường tĩnh mạch."},
    {a: "benh_tieu_duong_loai_2", b: "metformin", fact_id: "1c9d387c5654", evidence: "Hầu hết các loại thuốc uống, bao gồm sulfonylureas và metformin, nên được ngừng sử dụng vào ngày phẫu thuật và nên đo nồng độ glucose huyết tương trước và sau phẫu thuật và 6 giờ một lần trong khi bệnh nhân được truyền dịch đường tĩnh mạch."}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:TREATED_BY {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_5
}
CALL {
  WITH source
  UNWIND [
    {a: "dai_thao_duong", b: "suy_giam_dieu_hoa_glucose", fact_id: "54011384f001", evidence: "Suy giảm điều hòa glucose (Rối loạn dung nạp glucose, hoặc rối loạn glucose lúc đói – xem bảng ) là trung gian, giai đoạn chuyển tiếp, tình trạng giữa chuyển hóa glucose bình thường và đái tháo đường, và trở nên phổ biến hơn với sự già hóa."},
    {a: "dai_thao_duong", b: "benh_xo_nang", fact_id: "db70b63dd5de", evidence: "Các tình trạng ảnh hưởng đến tuyến tụy (ví dụ: bệnh xơ nang , viêm tụy , bệnh huyết sắc tố , cắt bỏ toàn thân)"},
    {a: "dai_thao_duong", b: "cat_bo_toan_than", fact_id: "7b569b51135c", evidence: "Các tình trạng ảnh hưởng đến tuyến tụy (ví dụ: bệnh xơ nang , viêm tụy , bệnh huyết sắc tố , cắt bỏ toàn thân)"},
    {a: "dai_thao_duong", b: "do_tuoi", fact_id: "070868c43bcf", evidence: "Giống như tất cả các mục tiêu về đường huyết, mục tiêu CGM nên được cá nhân hóa tùy thuộc vào độ tuổi, bệnh đi kèm và nguy cơ hạ đường huyết."},
    {a: "dai_thao_duong", b: "benh_ly_tim_mach", fact_id: "64d3c492f4fa", evidence: "Biến chứng có thể trì hoãn hoặc phòng tránh với kiểm soát đường huyết đầy đủ; bệnh lý tim mạch là nguyên nhân hàng đầu gây tử vong ở bệnh nhân đái tháo đường."},
    {a: "dai_thao_duong", b: "nguyen_nhan_cua_benh_tieu_duong", fact_id: "5c7fe8d4a05e", evidence: "Giáo dục nên bao gồm thông tin về những điều sau: Nguyên nhân của bệnh tiểu đường"},
    {a: "dai_thao_duong", b: "benh_nhan_cao_tuoi_de_mac_benh", fact_id: "1534b33f2e50", evidence: "Những mục tiêu này có thể được điều chỉnh để ít nghiêm ngặt hơn đối với những bệnh nhân không nên kiểm soát đường huyết chặt chẽ, chẳng hạn như Bệnh nhân cao tuổi dễ mắc bệnh"},
    {a: "dai_thao_duong", b: "tre_nho_benh_nhan_sa_sut_tri_tue", fact_id: "91834e2d2a44", evidence: "Những bệnh nhân không thể cho biết liệu có các triệu chứng hạ đường huyết hay không (ví dụ: trẻ nhỏ, bệnh nhân sa sút trí tuệ)"},
    {a: "dai_thao_duong", b: "benh_nhan_khong_duoc_dieu_tri_bang_thuoc_gay_ha_duong_huyet", fact_id: "92dee66f90e4", evidence: "Các ứng cử viên tiềm năng để kiểm soát đường huyết chặt chẽ hơn bao gồm Bệnh nhân không được điều trị bằng thuốc gây hạ đường huyết"},
    {a: "dai_thao_duong", b: "benh_di_kem", fact_id: "d99656c6fb63", evidence: "Giống như tất cả các mục tiêu về đường huyết, mục tiêu CGM nên được cá nhân hóa tùy thuộc vào độ tuổi, bệnh đi kèm và nguy cơ hạ đường huyết."},
    {a: "dai_thao_duong", b: "nguy_co_ha_duong_huyet", fact_id: "423ceea9e36c", evidence: "Giống như tất cả các mục tiêu về đường huyết, mục tiêu CGM nên được cá nhân hóa tùy thuộc vào độ tuổi, bệnh đi kèm và nguy cơ hạ đường huyết."},
    {a: "dai_thao_duong", b: "nguy_co_ha_duong_huyet_nang", fact_id: "5188b61568c3", evidence: "Để giảm nguy cơ hạ đường huyết nặng, thời gian dưới mức ( < 70 mg/dL [ < 3,9 mmol/L]) phải < 4% và thời gian dưới 54 mg/L ( < 3,0 mmol/L) phải < 1% ( 7, 8 )."},
    {a: "dai_thao_duong_tuyp_1", b: "insulin", fact_id: "977da0bc22b5", evidence: "Tự kháng thể gồm glutamic acid decarboxylase, insulin , proinsulin, protein liên quan u tiết insulin, Vận chuyển kẽm ZnT8, và protein khác trong tế bào beta. Người ta cho rằng những protein này được phơi nhiễm hoặc giải phóng trong quá trình thay đổi tế bào beta bình thường hoặc tổn thương tế bào beta (ví dụ: do nhiễm trùng), chủ yếu kích hoạt đáp ứng miễn dịch qua trung gian tế bào T dẫn đến phá hủy tế bào beta (viêm đảo tụy)."},
    {a: "dai_thao_duong_tuyp_1", b: "hla_dr3_dqb1_0201", fact_id: "b3f6860ed6ca", evidence: "Gen nhay cảm gồm gen trong phức hợp hòa hợp mô chính (MHC) – đặc biệt HLA-DR3,DQB1*0201 và HLA-DR4,DQB1*0302, chúng xuất hiện trong > 90% bệnh nhân đái tháo đường loại 1 và những gen ngoài MHC, điều hòa sản xuất và chế biến và vận chuyển insulin , nguy cơ đái tháo đường với gen MHC."},
    {a: "dai_thao_duong_tuyp_1", b: "gen_mhc", fact_id: "83a554d64d50", evidence: "Gen nhay cảm gồm gen trong phức hợp hòa hợp mô chính (MHC) – đặc biệt HLA-DR3,DQB1*0201 và HLA-DR4,DQB1*0302, chúng xuất hiện trong > 90% bệnh nhân đái tháo đường loại 1 và những gen ngoài MHC, điều hòa sản xuất và chế biến và vận chuyển insulin , nguy cơ đái tháo đường với gen MHC."},
    {a: "dai_thao_duong_tuyp_1", b: "gen_ngoai_mhc", fact_id: "2b3c6721cf0d", evidence: "Gen nhay cảm gồm gen trong phức hợp hòa hợp mô chính (MHC) – đặc biệt HLA-DR3,DQB1*0201 và HLA-DR4,DQB1*0302, chúng xuất hiện trong > 90% bệnh nhân đái tháo đường loại 1 và những gen ngoài MHC, điều hòa sản xuất và chế biến và vận chuyển insulin , nguy cơ đái tháo đường với gen MHC."},
    {a: "dai_thao_duong_tuyp_1", b: "nguoi_scandinavi", fact_id: "3a6a8ca6cd1a", evidence: "Các gen nhạy cảm phổ biến hơn ở một số quần thể so với những quần thể khác và giải thích tỷ lệ mắc bệnh tiểu đường loại 1 cao hơn ở những người có nguồn gốc từ một số khu vực nhất định (ví dụ: người Scandinavi, người Sardinia)."},
    {a: "dai_thao_duong_tuyp_1", b: "nguoi_sardinia", fact_id: "9876bebff5ed", evidence: "Các gen nhạy cảm phổ biến hơn ở một số quần thể so với những quần thể khác và giải thích tỷ lệ mắc bệnh tiểu đường loại 1 cao hơn ở những người có nguồn gốc từ một số khu vực nhất định (ví dụ: người Scandinavi, người Sardinia)."},
    {a: "dai_thao_duong_tuyp_1", b: "glutamic_acid_decarboxylase", fact_id: "d98bc100c15d", evidence: "Tự kháng thể gồm glutamic acid decarboxylase, insulin , proinsulin, protein liên quan u tiết insulin, Vận chuyển kẽm ZnT8, và protein khác trong tế bào beta. Người ta cho rằng những protein này được phơi nhiễm hoặc giải phóng trong quá trình thay đổi tế bào beta bình thường hoặc tổn thương tế bào beta (ví dụ: do nhiễm trùng), chủ yếu kích hoạt đáp ứng miễn dịch qua trung gian tế bào T dẫn đến phá hủy tế bào beta (viêm đảo tụy)."},
    {a: "dai_thao_duong_tuyp_1", b: "proinsulin", fact_id: "22bf6701a345", evidence: "Tự kháng thể gồm glutamic acid decarboxylase, insulin , proinsulin, protein liên quan u tiết insulin, Vận chuyển kẽm ZnT8, và protein khác trong tế bào beta. Người ta cho rằng những protein này được phơi nhiễm hoặc giải phóng trong quá trình thay đổi tế bào beta bình thường hoặc tổn thương tế bào beta (ví dụ: do nhiễm trùng), chủ yếu kích hoạt đáp ứng miễn dịch qua trung gian tế bào T dẫn đến phá hủy tế bào beta (viêm đảo tụy)."},
    {a: "dai_thao_duong_tuyp_1", b: "protein_lien_quan_u_tiet_insulin", fact_id: "ef215b94ee1d", evidence: "Tự kháng thể gồm glutamic acid decarboxylase, insulin , proinsulin, protein liên quan u tiết insulin, Vận chuyển kẽm ZnT8, và protein khác trong tế bào beta. Người ta cho rằng những protein này được phơi nhiễm hoặc giải phóng trong quá trình thay đổi tế bào beta bình thường hoặc tổn thương tế bào beta (ví dụ: do nhiễm trùng), chủ yếu kích hoạt đáp ứng miễn dịch qua trung gian tế bào T dẫn đến phá hủy tế bào beta (viêm đảo tụy)."},
    {a: "dai_thao_duong_tuyp_1", b: "van_chuyen_kem_znt8", fact_id: "97298652d646", evidence: "Tự kháng thể gồm glutamic acid decarboxylase, insulin , proinsulin, protein liên quan u tiết insulin, Vận chuyển kẽm ZnT8, và protein khác trong tế bào beta. Người ta cho rằng những protein này được phơi nhiễm hoặc giải phóng trong quá trình thay đổi tế bào beta bình thường hoặc tổn thương tế bào beta (ví dụ: do nhiễm trùng), chủ yếu kích hoạt đáp ứng miễn dịch qua trung gian tế bào T dẫn đến phá hủy tế bào beta (viêm đảo tụy)."},
    {a: "dai_thao_duong_tuyp_1", b: "protein_khac_trong_te_bao_beta", fact_id: "608b95111b11", evidence: "Tự kháng thể gồm glutamic acid decarboxylase, insulin , proinsulin, protein liên quan u tiết insulin, Vận chuyển kẽm ZnT8, và protein khác trong tế bào beta. Người ta cho rằng những protein này được phơi nhiễm hoặc giải phóng trong quá trình thay đổi tế bào beta bình thường hoặc tổn thương tế bào beta (ví dụ: do nhiễm trùng), chủ yếu kích hoạt đáp ứng miễn dịch qua trung gian tế bào T dẫn đến phá hủy tế bào beta (viêm đảo tụy)."},
    {a: "dai_thao_duong_tuyp_1", b: "tu_khang_the_lien_quan_den_benh_tieu_duong", fact_id: "1370401b33e5", evidence: "Tuy nhiên, họ phát triển các tự kháng thể liên quan đến bệnh tiểu đường và rối loạn đường huyết trước khi có triệu chứng."},
    {a: "dai_thao_duong_tuyp_1", b: "roi_loan_duong_huyet", fact_id: "67945d1d8e8f", evidence: "Tuy nhiên, họ phát triển các tự kháng thể liên quan đến bệnh tiểu đường và rối loạn đường huyết trước khi có triệu chứng."},
    {a: "dai_thao_duong_tuyp_1", b: "viem_trung_gian_tu_mien_trong_te_bao_beta_tuy", fact_id: "c18e3f9ebac4", evidence: "Nguyên nhân gây ra đái tháo đường loại 1 là do không có sản sinh insulin do tình trạng viêm trung gian tự miễn trong tế bào beta tụy."},
    {a: "dai_thao_duong_loai_2", b: "beo_phi", fact_id: "7b13d2180536", evidence: "Bệnh tiểu đường loại 2 đã trở nên phổ biến hơn ở trẻ em vì béo phì ở trẻ em đã trở thành một bệnh dịch."},
    {a: "dai_thao_duong_loai_2", b: "da_hinh_di_truyen", fact_id: "9e57ee819bad", evidence: "Mặc dù một số đa hình di truyền đã được xác định, nhưng không có gen đơn lẻ nào là nguyên nhân gây ra các dạng bệnh tiểu đường loại 2 phổ biến nhất được xác định."},
    {a: "dai_thao_duong_loai_2", b: "khang_insulin_tai_gan", fact_id: "be5a988042ec", evidence: "Đái tháo đường loại 2 gây ra bởi kháng insulin tại gan (gây không khả năng ức chế gan tân tạo glucose), kháng insulin ngoại vi (làm suy giảm lượng glucose hấp thụ ở ngoại vi), kết hợp với khiếm khuyết bài tiết tế bào beta của tuyến tụy."},
    {a: "dai_thao_duong_khong_on_dinh", b: "dai_thao_duong_tuyp_1", fact_id: "7837149b6d31", evidence: "Nồng độ glucose huyết tương dễ biến đổi có thể xuất hiện ở bệnh nhân đái tháo đường loại 1 vì sản xuất insulin nội sinh gần như là hoàn toàn không có, và trong một số bệnh nhân, điều hòa đáp ứng với hạ đường huyết bị suy giảm."},
    {a: "dai_thao_duong_khong_on_dinh", b: "nhiem_trung", fact_id: "85296bf17616", evidence: "Nguyên nhân khác khiến nồng độ glucose trong huyết tương không ổn định gồm nhiễm trùng, liệt dạ dày (dẫn tới rối loạn hấp thu carbonhydrate) và bệnh nội tiết (ví dụ, bệnh Addison )."},
    {a: "dai_thao_duong_khong_on_dinh", b: "liet_da_day", fact_id: "438e6d7e3ad1", evidence: "Nguyên nhân khác khiến nồng độ glucose trong huyết tương không ổn định gồm nhiễm trùng, liệt dạ dày (dẫn tới rối loạn hấp thu carbonhydrate) và bệnh nội tiết (ví dụ, bệnh Addison )."},
    {a: "dai_thao_duong_khong_on_dinh", b: "benh_noi_tiet", fact_id: "6f177e953e24", evidence: "Nguyên nhân khác khiến nồng độ glucose trong huyết tương không ổn định gồm nhiễm trùng, liệt dạ dày (dẫn tới rối loạn hấp thu carbonhydrate) và bệnh nội tiết (ví dụ, bệnh Addison )."},
    {a: "dai_thao_duong_khong_on_dinh", b: "giao_duc_hoac_hieu_biet_cua_benh_nhan_khong_day_du", fact_id: "8029787f1c33", evidence: "Bệnh nhân với khó khăn kéo dài trong duy trì glucose trong khoảng chấp nhận được nên được đánh giá các yếu tố ảnh hưởng tới kiểm soát glucose. Những yếu tố này bao gồm việc giáo dục hoặc hiểu biết của bệnh nhân không đầy đủ dẫn đến sai sót trong sử dụng insulin , lựa chọn thực phẩm không phù hợp và căng thẳng tâm lý xã hội biểu hiện qua các kiểu sử dụng thuốc và lượng thức ăn ăn vào thất thường."},
    {a: "dai_thao_duong_khong_on_dinh", b: "cang_thang_tam_ly_xa_hoi", fact_id: "93d450a31392", evidence: "Bệnh nhân với khó khăn kéo dài trong duy trì glucose trong khoảng chấp nhận được nên được đánh giá các yếu tố ảnh hưởng tới kiểm soát glucose. Những yếu tố này bao gồm việc giáo dục hoặc hiểu biết của bệnh nhân không đầy đủ dẫn đến sai sót trong sử dụng insulin , lựa chọn thực phẩm không phù hợp và căng thẳng tâm lý xã hội biểu hiện qua các kiểu sử dụng thuốc và lượng thức ăn ăn vào thất thường."}
  ] AS row
  MATCH (a:DiabetesConcept {id: row.a})
  MATCH (b:DiabetesConcept {id: row.b})
  MERGE (a)-[r:HAS_RISK_FACTOR {source_id: source.id, fact_id: row.fact_id}]->(b)
  SET r += row, r.a = null, r.b = null, r.fact_id = row.fact_id
  RETURN count(*) AS rel_count_6
}
RETURN source.id AS source_id, concept_count,
       rel_count_1 + rel_count_2 + rel_count_3 + rel_count_4 + rel_count_5 + rel_count_6 AS fact_count;
